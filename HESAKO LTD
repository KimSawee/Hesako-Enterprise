H.paintCalendar = function(){
  var grid = document.getElementById('calGrid'); if (!grid) return;
  var y = calMonth.getFullYear(), m = calMonth.getMonth();
  var MN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('calLabel').textContent = MN[m] + ' ' + y;
  var startDow = new Date(Date.UTC(y, m, 1)).getUTCDay();
  var daysInMonth = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
  var today = todayISO(), events = {};
  function push(ds, label, cls){ if (!ds) return; (events[ds] = events[ds] || []).push({ label:label, kind:cls }); }
  State.tenders.filter(function(t){ return !t.archived; }).forEach(function(t){
    push(t.submissionDate, t.title, 'submission');
    push(t.publicationDate, t.title, 'other');
    push(t.questionDeadline, t.title, 'other');
    push(t.siteVisitDate, t.title, 'other');
    push(t.openingDate, t.title, 'other');
  });
  var html = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(function(d){ return '<div class="cal-head">' + d + '</div>'; }).join('');
  for (var i = 0; i < startDow; i++) html += '<div class="cal-day out"></div>';
  for (var d = 1; d <= daysInMonth; d++) {
    var ds = y + '-' + ('0'+(m+1)).slice(-2) + '-' + ('0'+d).slice(-2);
    var evs = (events[ds] || []).slice(0,3);
    html += '<div class="cal-day' + (ds === today ? ' today' : '') + '"><div class="dnum">' + d + '</div>' + evs.map(function(e){
      var k = 'other';
      if (e.kind === 'submission') {
        var dd = daysLeft(ds, '23:59');
        k = dd !== null && dd < 0 ? 'over' : (dd !== null && dd < 1 ? 'today' : '');
      }
      return '<span class="cal-ev ' + k + '" title="' + esc(e.label) + '">' + esc(e.label) + '</span>';
    }).join('') + '</div>';
  }
  grid.innerHTML = html;
};
H.afterRenderCalendar = function(){
  H.paintCalendar();
