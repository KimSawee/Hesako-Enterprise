      '<div>' +
        '<div class="panel"><div class="panel-head"><h3>Upcoming &amp; overdue deadlines</h3>' +
          '<a class="btn btn-outline btn-sm" href="#/admin/calendar">Open deadline centre</a></div>' +
          '<div class="panel-body">' + (dueList.length ? dueList.map(deadlineRow).join('')
            : '<div class="empty">Nothing due in the next 7 days. <a href="#/admin/tender-new">Add a tender</a> to start tracking.</div>') + '</div>' +
          '<div class="panel-foot"><span class="muted" style="font-size:.82rem">All times in Africa/Nairobi (EAT, UTC+3)</span>' +
          '<span class="muted" style="font-size:.82rem">Overdue ' + b.overdue.length + ' · Today ' + b.today.length + ' · ≤3 days ' + b.d3.length + ' · ≤7 days ' + b.d7.length + '</span></div>' +
        '</div>' +
        '<div class="panel mt2"><div class="panel-head"><h3>New website orders &amp; enquiries</h3>' +
          '<a class="btn btn-outline btn-sm" href="#/admin/orders">All orders</a></div>' +
          '<div class="panel-body">' + (newOrders.length ? '<div class="table-wrap"><table><thead><tr>' +
            '<th class="no-sort">Reference</th><th class="no-sort">Customer</th><th class="no-sort">Type</th><th class="no-sort">Received</th><th class="no-sort"></th></tr></thead><tbody>' +
            newOrders.map(function(o){
              return '<tr><td class="mono">' + esc(o.ref) + '</td><td>' + esc(o.customer) + sampleTag(o) + '</td><td>' + esc(o.type) + '</td><td>' + esc(fmtDate(o.createdAt)) + '</td>' +
                '<td class="actions"><a class="btn btn-xs btn-outline" href="#/admin/orders?id=' + esc(o.id) + '">Open</a></td></tr>';
