      kpi('','Unsuccessful', unsucc, 'Not awarded') +
      kpi('k-navy','Total quoted value', money0(quoted), 'Sum of quoted totals on records') +
      kpi('k-navy','Confirmed order value', money0(confirmedValue), 'Confirmed, in progress, completed') +
