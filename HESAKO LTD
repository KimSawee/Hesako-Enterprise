  return rec && rec.sample ? ' <span class="badge b-sample" title="Sample data — safe to delete">Sample</span>' : '';
}
function kpi(cls, label, value, note){
  return '<div class="kpi ' + cls + '"><div class="k-label">' + esc(label) + '</div>' +
    '<div class="k-value">' + value + '</div><div class="k-note">' + esc(note || '') + '</div></div>';
}
function emptyBox(title, msg, cta){
  return '<div class="empty"><h3 style="margin-bottom:.3rem">' + esc(title) + '</h3><p class="muted" style="margin:0">' + esc(msg) + '</p>' + (cta || '') + '</div>';
}
function on(id, ev, fn){ var el = document.getElementById(id); if (el) el.addEventListener(ev, fn); return el; }
function val(id){ var el = document.getElementById(id); return el ? el.value.trim() : ''; }
function setErr(fieldId, msg){
  var el = document.getElementById(fieldId);
  if (!el) return;
  var f = el.closest('.field');
  if (!f) return;
  f.classList.add('invalid');
  var e = f.querySelector('.err');
  if (e) e.textContent = msg;
}
function clearErrs(formEl){
  Array.prototype.forEach.call(formEl.querySelectorAll('.field.invalid'), function(f){ f.classList.remove('invalid'); });
}
function applyPerms(){
  Array.prototype.forEach.call(document.querySelectorAll('[data-perm]'), function(el){
    var need = el.getAttribute('data-perm');
    if (!can(need)) el.classList.add('hide');
  });
}
</script>








