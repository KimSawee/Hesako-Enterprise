function submitOrder(){
  var form = document.getElementById('orderForm');
  clearErrs(form);
  var errs = [];
  function need(id, ok, msg){ if (!ok) { setErr(id, msg); errs.push(id); } }
  var type = val('oType'), serviceId = val('oService');
  var cust = val('oCustomer'), contact = val('oContact'), phone = val('oPhone'), email = val('oEmail');
  var loc = val('oLocation'), budget = val('oBudget'), reqDate = val('oDate'), specs = val('oSpecs'), qty = val('oQty');
  need('oType', !!type, 'Please choose the type of request.');
  need('oService', !!serviceId, 'Please choose a service or product.');
  need('oCustomer', cust.length >= 2, 'Enter the customer or business name.');
  need('oContact', contact.length >= 2, 'Enter a contact person.');
  var digits = phone.replace(/[^0-9]/g,'');
  need('oPhone', digits.length >= 9, 'Enter a valid phone number (at least 9 digits).');
  need('oEmail', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email), 'Enter a valid email address.');
  need('oLocation', loc.length >= 2, 'Enter the delivery location.');
  if (budget && !/^\d+(\.\d+)?$/.test(budget)) need('oBudget', false, 'Enter a number, digits only.');
  if (reqDate && reqDate < todayISO()) need('oDate', false, 'The required date cannot be in the past.');
  if (!document.getElementById('oConsent').checked) {
    document.getElementById('consentErr').style.display = 'block'; errs.push('oConsent');
  } else document.getElementById('consentErr').style.display = 'none';

  if (errs.length) {
    var first = document.getElementById(errs[0]);
    if (first) { try { first.scrollIntoView({block:'center',behavior:'smooth'}); first.focus({preventScroll:true}); } catch(e){ first.focus(); } }
    toast('error','Please check the form','Some required details are missing or invalid. They are highlighted in red.');
    return;
  }

  var btn = document.getElementById('oSubmit');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Saving…';

  var svc = State.services.filter(function(s){ return s.id === serviceId; })[0];
  var serviceName = svc ? svc.name : serviceId;
  var ref = refNo('HES');
  var fileInput = document.getElementById('oFile');
  var attachmentName = '', attachmentData = '';

  var afterFile = function(){
    var order = {
      id: uid('or'), ref: ref, type: type, customer: cust, contactPerson: contact, phone: phone, email: email,
      service: serviceName, qty: qty, location: loc, requiredDate: reqDate, budget: num(budget),
      specifications: specs, attachmentName: attachmentName, attachmentData: attachmentData,
      status: 'New', createdAt: todayISO(), updatedAt: todayISO(), notes: '', sample: false
    };
    State.orders.unshift(order);
    /* customer record: match on email, else create */
    var existing = State.customers.filter(function(c){ return (c.email||'').toLowerCase() === email.toLowerCase(); })[0];
    if (existing) {
      existing.phone = phone || existing.phone;
      existing.contactPerson = contact || existing.contactPerson;
      existing.location = loc || existing.location;
      if (existing.status === 'Prospect') existing.status = 'Active';
    } else {
      State.customers.unshift({ id: uid('cu'), name: cust, contactPerson: contact, phone: phone, email: email,
        location: loc, status: 'Prospect', followUp: addDays(todayISO(), 2),
        notes: 'Created automatically from website ' + type.toLowerCase() + ' ' + ref + '.', createdAt: todayISO(), sample: false });
    }
    logActivity('New website ' + type.toLowerCase() + ' ' + ref + ' from ' + cust);
    var saved = save();

    btn.disabled = false;
    btn.textContent = 'Submit request';

    if (!saved) {
      toast('error','Could not save to this browser','Storage is blocked, so the request could not be stored. Please send it on WhatsApp or email instead.');
      return;
    }
    showOrderConfirmation(order);
  };

  if (fileInput && fileInput.files && fileInput.files[0]) {
    var f = fileInput.files[0];
    attachmentName = f.name + ' (' + Math.round(f.size/1024) + 'KB)';
    if (f.size <= 300 * 1024) {
      var reader = new FileReader();
      reader.onload = function(){ attachmentData = String(reader.result || ''); afterFile(); };
      reader.onerror = function(){ afterFile(); };
      reader.readAsDataURL(f);
      return;
    }
    afterFile();
    return;
  }
  afterFile();
}

