/* ------------------------------ store ------------------------------ */
var State = null;
var StorageOK = true;
function storageGet(k){ try { return window.localStorage.getItem(k); } catch(e){ return null; } }
function storageSet(k,v){ try { window.localStorage.setItem(k,v); return true; } catch(e){ StorageOK = false; return false; } }
function storageRemove(k){ try { window.localStorage.removeItem(k); } catch(e){} }

function loadState(){
  var raw = storageGet(STORE_KEY);
  if (raw) {
    try {
      var parsed = JSON.parse(raw);
      if (parsed && parsed.services && parsed.settings) { State = parsed; return; }
    } catch(e){ /* corrupted — reseed below */ }
  }
  State = seedState();
  save();
}
function save(){
  var ok = storageSet(STORE_KEY, JSON.stringify(State));
  if (!ok && StorageOK) { toast('warn','Changes not saved','This browser blocked local storage, so edits last only for this session.'); }
  return ok;
}
function logActivity(text){
  State.activity.unshift({ at: nowStamp(), text: text, by: (Session && Session.name) || 'System' });
  State.activity = State.activity.slice(0, 60);
}

/* ------------------------------ session ------------------------------ */
var Session = null;
function loadSession(){
  var raw = storageGet(SESSION_KEY);
  if (!raw) return;
  try {
    var s = JSON.parse(raw);
    if (s && s.username && (Date.now() - s.startedAt) < 1000*60*60*12) Session = s;
    else storageRemove(SESSION_KEY);
  } catch(e){ storageRemove(SESSION_KEY); }
}
function setSession(u){
  Session = { userId:u.id, username:u.username, name:u.name, role:u.role, startedAt:Date.now() };
  storageSet(SESSION_KEY, JSON.stringify(Session));
}
function clearSession(){ Session = null; storageRemove(SESSION_KEY); }
function can(area){
  if (!Session) return false;
  var r = ROLES[Session.role] || ROLES.Staff;
  return r.indexOf('all') !== -1 || r.indexOf(area) !== -1;
}
function isAdmin(){ return Session && Session.role === 'Administrator'; }

/* ------------------------------ toast + modal ------------------------------ */
function toast(kind, title, msg){
  var host = document.getElementById('toasts');
  if (!host) return;
  var el = document.createElement('div');
  el.className = 'toast ' + (kind === 'ok' ? '' : kind);
  el.innerHTML = '<b>' + esc(title) + '</b>' + esc(msg || '');
  host.appendChild(el);
  setTimeout(function(){
    el.style.transition = 'opacity .3s,transform .3s';
    el.style.opacity = '0'; el.style.transform = 'translateX(16px)';
    setTimeout(function(){ if (el.parentNode) el.parentNode.removeChild(el); }, 320);
  }, kind === 'error' ? 6500 : 4200);
}
function openModal(opts){
  closeModal();
  var host = document.getElementById('modals');
  var back = document.createElement('div');
  back.className = 'modal-back';
  back.setAttribute('role','dialog');
  back.setAttribute('aria-modal','true');
  back.innerHTML =
    '<div class="modal ' + (opts.wide ? 'wide' : '') + '">' +
      '<div class="modal-head"><h3>' + esc(opts.title || '') + '</h3>' +
        '<button class="x" data-close="1" aria-label="Close">&times;</button></div>' +
      '<div class="modal-body">' + (opts.body || '') + '</div>' +
      (opts.foot ? '<div class="modal-foot">' + opts.foot + '</div>' : '') +
    '</div>';
  back.addEventListener('click', function(e){
    if (e.target === back || e.target.getAttribute('data-close')) closeModal();
  });
  host.appendChild(back);
  var f = back.querySelector('input,select,textarea,button:not(.x)');
  if (f) setTimeout(function(){ try{ f.focus(); }catch(e){} }, 60);
  return back;
}
function closeModal(){ var h = document.getElementById('modals'); if (h) h.innerHTML = ''; }
function confirmAction(title, message, onYes, yesLabel){
  openModal({
    title: title,
    body: '<p style="margin:0">' + esc(message) + '</p>',
    foot: '<button class="btn btn-outline" data-close="1">Cancel</button>' +
          '<button class="btn btn-danger" id="cmYes">' + esc(yesLabel || 'Confirm') + '</button>'
  });
  document.getElementById('cmYes').addEventListener('click', function(){ closeModal(); onYes(); });
}
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });

/* ------------------------------ router ------------------------------ */
var PUBLIC_ROUTES = { '/':'home', '/services':'services', '/examples':'examples', '/partners':'partners', '/order':'order', '/track':'track', '/contact':'contact', '/quote':'quotation' };
var ADMIN_ROUTES = ['/admin','/admin/tenders','/admin/tender-new','/admin/tender','/admin/calendar','/admin/rates','/admin/quotes','/admin/partners','/admin/orders','/admin/customers','/admin/reports','/admin/settings','/admin/users','/admin/system'];

function currentRoute(){
  var h = window.location.hash.replace(/^#/,'');
  if (!h || h === '/') return { path:'/', query:{} };
  var qi = h.indexOf('?'), q = {}, path = h;
  if (qi !== -1) {
    path = h.slice(0,qi);
    h.slice(qi+1).split('&').forEach(function(kv){
      var p = kv.split('='); if (p[0]) q[decodeURIComponent(p[0])] = decodeURIComponent(p[1] || '');
    });
  }
  if (path.length > 1 && path.slice(-1) === '/') path = path.slice(0,-1);
  return { path:path, query:q };
}
function go(path){
  var target = '#' + path;
  /* if we are already on that path no hashchange event will fire, so render
     directly — otherwise a same-page navigation (for example straight after
     sign-in) would silently do nothing */
  if (window.location.hash === target) render();
  else window.location.hash = target;
}

function render(){
  var r = currentRoute();
  var main = document.getElementById('main');
  var isAdminRoute = r.path.indexOf('/admin') === 0;
  document.getElementById('mainNav').classList.remove('open');
  document.getElementById('burger').setAttribute('aria-expanded','false');

  /* nav active state */
  var navKey = r.path === '/admin' ? 'admin' : (PUBLIC_ROUTES[r.path] || '');
  Array.prototype.forEach.call(document.querySelectorAll('.main-nav a[data-route]'), function(a){
    a.classList.toggle('active', a.getAttribute('data-route') === navKey);
  });
  var al = document.getElementById('adminNavLink');
  if (al) al.textContent = Session ? 'Dashboard' : 'Admin Login';

  document.body.classList.toggle('admin-mode', isAdminRoute);
  var header = document.querySelector('.site-header'), tb = document.querySelector('.top-bar'), ft = document.querySelector('.site-footer');
  [header, tb, ft].forEach(function(el){ if (el) el.classList.toggle('hide', isAdminRoute); });

  if (isAdminRoute) {
    if (window.HESAKO && window.HESAKO.renderAdminArea) window.HESAKO.renderAdminArea(r);
    else document.getElementById('main').innerHTML = '<div class="wrap section"><div class="notice notice-bad">The dashboard module did not load. Please reload the page.</div></div>';
  } else {
    window.scrollTo(0,0);
    if (window.HESAKO && window.HESAKO.renderPublic) window.HESAKO.renderPublic(r, main);
    ensureFooter();
  }
}
function ensureFooter(){
  var f = document.querySelector('.site-footer');
  if (!f) {
    f = document.createElement('footer');
    f.className = 'site-footer no-print';
    document.body.appendChild(f);
  }
  f.innerHTML = footerHTML();
  if (!document.querySelector('.wa-float')) {
    var a = document.createElement('a');
    a.className = 'wa-float no-print';
    a.href = COMPANY.whatsappLink; a.target = '_blank'; a.rel = 'noopener';
    a.innerHTML = '<span aria-hidden="true">✆</span> WhatsApp us';
    document.body.appendChild(a);
  }
}
