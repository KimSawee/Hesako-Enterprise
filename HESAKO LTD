        '<button class="btn btn-gold" id="digestCopy">Copy to clipboard</button>'
    });
    on('digestCopy','click', function(){
      var ta = document.getElementById('digestText');
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(ta.value).then(function(){ toast('ok','Copied','Deadline digest copied to the clipboard.'); },
            function(){ ta.select(); document.execCommand('copy'); toast('ok','Copied','Deadline digest copied.'); });
          return;
        }
      } catch(e){}
      ta.select(); document.execCommand('copy'); toast('ok','Copied','Deadline digest copied.');
    });
  });
  on('calMarkAll','click', function(){
    var n = 0;
    H.dueBuckets().overdue.forEach(function(t){ (t.tasks || []).forEach(function(tk){ if (!tk.done) { tk.done = true; n++; } }); });
    if (n) { logActivity('Marked ' + n + ' task(s) in overdue tenders as done'); save(); toast('ok','Tasks completed', n + ' task(s) marked done in overdue tenders.'); render(); }
    else toast('info','Nothing to update','No open tasks were found in overdue tenders.');
  });
};
H.exportDeadlinesCSV = function(){
