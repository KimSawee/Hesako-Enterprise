    rows.push([t.title, t.refNo, t.buyer, t.category, t.publicationDate, t.siteVisitDate, t.questionDeadline, t.submissionDate, t.submissionTime || '23:59', t.openingDate, t.status, countdownLabel(t.submissionDate, t.submissionTime).text, t.assignedTo]);
