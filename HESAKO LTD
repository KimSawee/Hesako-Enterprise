      btn.disabled = true; btn.innerHTML = '<span class="spinner dark"></span> Saving…';
      var row = rec || { id: uid('pt'), sample:false };
      row.brand = brand;
      row.name = val('ppLegal') || brand;
      row.industry = val('ppInd');
      row.categories = val('ppCats');
      row.contactPerson = val('ppContact');
      row.email = val('ppEmail');
      row.phone = val('ppPhone');
      row.website = val('ppWeb');
      row.partnershipType = val('ppType');
      row.status = val('ppStatus');
      row.products = val('ppProducts');
      row.rates = val('ppRates');
      row.priceList = val('ppRates');
      row.agreementStart = val('ppStart');
      row.agreementExpiry = val('ppExpiry');
      row.paymentTerms = val('ppPay');
      row.deliveryTerms = val('ppDel');
      row.nextFollowUp = val('ppFollow');
      row.documents = val('ppDocs') ? val('ppDocs').split(';').map(function(s){ return s.trim(); }).filter(Boolean) : [];
      row.notes = val('ppNotes');
      row.publicApproved = document.getElementById('ppPublic').checked;
      row.updatedAt = todayISO();
      if (!rec) State.partners.unshift(row);
      logActivity((rec ? 'Updated' : 'Added') + ' partner: ' + row.brand);
      if (!save()) { toast('error','Not saved','Local storage is blocked in this browser.'); return; }
      closeModal();
      toast('ok', rec ? 'Partner updated' : 'Partner added', row.brand + (row.publicApproved ? ' — now visible publicly.' : ' — kept private.'));
      reload();
    });
  }
  on('pNew','click', function(){ openPartner(null); });
  var n2 = document.getElementById('pNew2');
  if (n2) n2.addEventListener('click', function(){ openPartner(null); });
  on('pExport','click', function(){
    var rows = [['Brand','Company name','Industry','Categories','Contact person','Email','Phone','Website','Partnership type','Products','Negotiated rates','Agreement start','Agreement expiry','Payment terms','Delivery terms','Status','Public','Next follow-up','Notes','Sample']];
    State.partners.forEach(function(p){
      rows.push([p.brand || p.name, p.name, p.industry, p.categories, p.contactPerson, p.email, p.phone, p.website,
        p.partnershipType, p.products, p.rates || p.priceList, p.agreementStart, p.agreementExpiry, p.paymentTerms, p.deliveryTerms,
        p.status, p.publicApproved ? 'Yes' : 'No', p.nextFollowUp, p.notes, p.sample ? 'Yes' : 'No']);
    });
    if (downloadFile('hesako-partners-' + todayISO() + '.csv', toCSV(rows))) toast('ok','CSV exported','Partner directory exported — handle as confidential.');
  });
  host.addEventListener('click', function(e){
    var t = e.target;
    var ed = t.closest && t.closest('[data-pedit]');
    if (ed) { openPartner(State.partners.filter(function(x){ return x.id === ed.getAttribute('data-pedit'); })[0]); return; }
    var tg = t.closest && t.closest('[data-ptoggle]');
    if (tg) {
      var p = State.partners.filter(function(x){ return x.id === tg.getAttribute('data-ptoggle'); })[0];
      if (p) {
        p.publicApproved = !p.publicApproved;
        logActivity((p.publicApproved ? 'Published' : 'Unpublished') + ' partner: ' + (p.brand || p.name));
        save();
