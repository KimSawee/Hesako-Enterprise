<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HESAKO ENTERPRISE LTD — Tender Services &amp; Business Supplies</title>
<meta name="description" content="HESAKO ENTERPRISE LTD — your trusted partner in tender services, procurement support and business supplies in Kenya. Request a quotation, place an order, or ask for tender documentation support.">
<meta name="theme-color" content="#0B1F3A">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230B1F3A'/%3E%3Ctext x='32' y='44' font-family='Georgia,serif' font-size='34' font-weight='700' fill='%23C9A227' text-anchor='middle'%3EH%3C/text%3E%3C/svg%3E">
<style>
/* ============================================================
   HESAKO ENTERPRISE LTD — design system
   Navy / white / gold premium corporate theme
   ============================================================ */
:root{
  --navy:#0B1F3A;
  --navy-2:#12305C;
  --navy-3:#0a1a30;
  --gold:#C9A227;
  --gold-2:#E4C55E;
  --gold-soft:#FBF4DE;
  --ink:#13233d;
  --muted:#5B6B85;
  --line:#E2E8F1;
  --bg:#F5F7FB;
  --white:#FFFFFF;
  --ok:#1E8E5A;
  --ok-soft:#E7F6EE;
  --warn:#B26A00;
  --warn-soft:#FFF4E2;
  --bad:#C0392B;
  --bad-soft:#FDEDEB;
  --info:#2563EB;
  --info-soft:#EAF1FE;
  --shadow-sm:0 1px 2px rgba(11,31,58,.06), 0 2px 6px rgba(11,31,58,.05);
  --shadow:0 6px 24px rgba(11,31,58,.09);
  --shadow-lg:0 18px 48px rgba(11,31,58,.16);
  --r:14px;
  --r-sm:9px;
  --maxw:1200px;
  --sans:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  --serif:Georgia,'Times New Roman',serif;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:var(--sans);background:var(--bg);color:var(--ink);
  font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4{font-family:var(--serif);color:var(--navy);line-height:1.22;margin:0 0 .5em}
h1{font-size:clamp(1.9rem,4.4vw,3rem)}
h2{font-size:clamp(1.45rem,3vw,2.05rem)}
h3{font-size:1.16rem}
h4{font-size:1rem}
p{margin:0 0 1em}
a{color:var(--navy-2);text-decoration:none}
a:hover{color:var(--gold)}
img{max-width:100%;display:block}
small{font-size:.82rem}
hr{border:0;border-top:1px solid var(--line);margin:1.4rem 0}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 20px}
.wrap-narrow{max-width:820px;margin:0 auto;padding:0 20px}
.section{padding:56px 0}
.section-tight{padding:32px 0}
.eyebrow{
  font-family:var(--sans);font-size:.74rem;font-weight:700;letter-spacing:.18em;
  text-transform:uppercase;color:var(--gold);margin-bottom:.6rem
}
.lead{font-size:1.06rem;color:var(--muted);max-width:70ch}
.center{text-align:center}
.muted{color:var(--muted)}
.mt0{margin-top:0}.mb0{margin-bottom:0}.mt1{margin-top:1rem}.mt2{margin-top:2rem}.mb1{margin-bottom:1rem}.mb2{margin-bottom:2rem}
.hide{display:none !important}
.nowrap{white-space:nowrap}
.mono{font-family:'SFMono-Regular',Consolas,'Liberation Mono',monospace}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
  font-family:var(--sans);font-size:.94rem;font-weight:600;line-height:1;
  padding:.78rem 1.25rem;border-radius:var(--r-sm);border:1px solid transparent;
  cursor:pointer;transition:transform .12s ease,box-shadow .18s ease,background .18s ease,color .18s;
  text-decoration:none;white-space:nowrap
}
.btn:active{transform:translateY(1px)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn-gold{background:linear-gradient(180deg,var(--gold-2),var(--gold));color:#231a02;box-shadow:0 4px 14px rgba(201,162,39,.32)}
.btn-gold:hover{color:#231a02;box-shadow:0 8px 22px rgba(201,162,39,.42)}
.btn-navy{background:var(--navy);color:#fff}
.btn-navy:hover{background:var(--navy-2);color:#fff}
.btn-ghost{background:transparent;border-color:rgba(255,255,255,.45);color:#fff}
.btn-ghost:hover{background:rgba(255,255,255,.12);color:#fff}
.btn-outline{background:#fff;border-color:var(--line);color:var(--navy)}
.btn-outline:hover{border-color:var(--navy);color:var(--navy)}
.btn-danger{background:var(--bad-soft);color:var(--bad);border-color:#f3c9c3}
.btn-danger:hover{background:var(--bad);color:#fff}
.btn-sm{padding:.5rem .8rem;font-size:.84rem}
.btn-xs{padding:.34rem .6rem;font-size:.76rem;border-radius:7px}
.btn-block{width:100%}
.btn-row{display:flex;gap:.6rem;flex-wrap:wrap}

/* ---------- header ---------- */
.site-header{
  background:linear-gradient(180deg,var(--navy) 0%,var(--navy-3) 100%);
  color:#fff;position:sticky;top:0;z-index:60;box-shadow:0 2px 18px rgba(11,31,58,.22)
}
.header-inner{max-width:var(--maxw);margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:18px}
.brand{display:flex;align-items:center;gap:12px;color:#fff}
.brand:hover{color:#fff}
.brand-text{display:flex;flex-direction:column;line-height:1.12}
.brand-name{font-family:var(--serif);font-size:1.16rem;font-weight:700;letter-spacing:.055em}
.brand-sub{font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold-2)}
.main-nav{display:flex;align-items:center;gap:4px;margin-left:auto;flex-wrap:wrap}
.main-nav a{
  color:#dbe4f2;font-size:.9rem;font-weight:500;padding:.5rem .7rem;border-radius:8px
}
.main-nav a:hover{color:#fff;background:rgba(255,255,255,.1)}
.main-nav a.active{color:var(--gold-2)}
.nav-cta{margin-left:6px}
.top-bar{
  background:var(--navy-3);color:#c9d5e8;font-size:.78rem;border-bottom:1px solid rgba(255,255,255,.08)
}
.top-bar .wrap{display:flex;gap:18px;flex-wrap:wrap;justify-content:flex-end;padding:6px 20px}
.top-bar a{color:#c9d5e8}
.top-bar a:hover{color:var(--gold-2)}
.burger{display:none;margin-left:auto;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:8px;padding:.45rem .6rem;cursor:pointer;font-size:1.1rem;line-height:1}

/* ---------- fake-3D hero ---------- */
.hero{
  position:relative;background:radial-gradient(1100px 460px at 78% -12%,#1b4480 0%,transparent 62%),linear-gradient(160deg,var(--navy) 0%,var(--navy-2) 62%,#0d2547 100%);
  color:#fff;overflow:hidden;padding:76px 0 84px
}
.hero::after{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
  background-size:52px 52px;mask-image:linear-gradient(180deg,rgba(0,0,0,.7),transparent 82%);pointer-events:none
}
.hero .wrap{position:relative;z-index:2;display:grid;grid-template-columns:1.15fr .85fr;gap:44px;align-items:center}
.hero h1{color:#fff;font-size:clamp(1.95rem,4.6vw,3.15rem);margin-bottom:.55rem}
.hero .eyebrow{color:var(--gold-2)}
.hero p.lead{color:#d5e0f1;font-size:1.08rem}
.hero-panel{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:18px;
  padding:22px;backdrop-filter:blur(4px);box-shadow:var(--shadow-lg)
}
.hero-panel h3{color:#fff;margin-bottom:.7rem;font-size:1.05rem}
.hero-stat{display:flex;justify-content:space-between;gap:10px;padding:.6rem 0;border-bottom:1px dashed rgba(255,255,255,.18)}
.hero-stat:last-child{border-bottom:0}
.hero-stat b{color:var(--gold-2);font-family:var(--serif);font-size:1.05rem}
.hero-stat span{font-size:.88rem;color:#cfdbee}

/* ---------- cards / grids ---------- */
.grid{display:grid;gap:18px}
.g2{grid-template-columns:repeat(2,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r);
  padding:20px;box-shadow:var(--shadow-sm);transition:box-shadow .18s,transform .18s
}
.card-hover:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.card-flat{box-shadow:none}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.card h3{margin-bottom:.35rem}
.card .service-meta{font-size:.85rem;color:var(--muted);margin:.35rem 0}
.panel{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm);overflow:hidden}
.panel-head{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#fbfcfe}
.panel-head h3{margin:0}
.panel-body{padding:18px}
.panel-foot{padding:14px 18px;border-top:1px solid var(--line);background:#fbfcfe;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

/* ---------- badges / pills ---------- */
.badge{
  display:inline-flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:700;letter-spacing:.03em;
  padding:.28rem .58rem;border-radius:999px;text-transform:uppercase;white-space:nowrap
}
.b-grey{background:#eef1f6;color:#4c5b74}
.b-blue{background:var(--info-soft);color:var(--info)}
.b-green{background:var(--ok-soft);color:var(--ok)}
.b-gold{background:var(--gold-soft);color:#8b6c05}
.b-amber{background:var(--warn-soft);color:var(--warn)}
.b-red{background:var(--bad-soft);color:var(--bad)}
.b-navy{background:var(--navy);color:#fff}
.b-sample{background:#efe7ff;color:#5b34b8}
.pill{display:inline-block;font-size:.74rem;padding:.2rem .55rem;border-radius:999px;background:#eef2f8;color:var(--muted);margin:0 .3rem .3rem 0}

/* ---------- forms ---------- */
.field{margin-bottom:15px}
.field label{display:block;font-size:.85rem;font-weight:600;color:var(--navy);margin-bottom:.35rem}
.field .hint{font-size:.78rem;color:var(--muted);font-weight:400}
.field .err{font-size:.78rem;color:var(--bad);margin-top:.3rem;display:none}
.field.invalid .err{display:block}
.field.invalid input,.field.invalid select,.field.invalid textarea{border-color:var(--bad);background:#fffafa}
input,select,textarea{
  width:100%;font-family:var(--sans);font-size:.94rem;color:var(--ink);
  padding:.68rem .75rem;border:1px solid #cfd8e6;border-radius:var(--r-sm);background:#fff;transition:border-color .15s,box-shadow .15s
}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--navy-2);box-shadow:0 0 0 3px rgba(18,48,92,.12)}
textarea{min-height:96px;resize:vertical}
input[type=file]{padding:.5rem;background:#fbfcfe}
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 16px}
.form-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:0 16px}
.span2{grid-column:span 2}
.span3{grid-column:span 3}
.check{display:flex;align-items:flex-start;gap:.55rem;font-size:.88rem;margin-bottom:.45rem}
.check input{width:auto;margin-top:.25rem}

/* ---------- tables ---------- */
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:.88rem;min-width:640px}
th,td{padding:.7rem .8rem;text-align:left;border-bottom:1px solid var(--line);vertical-align:middle}
th{background:#f7f9fc;color:var(--navy);font-weight:700;font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;cursor:pointer;user-select:none}
th.no-sort{cursor:default}
th .arrow{color:var(--gold);font-size:.7rem}
tbody tr:hover{background:#fbfcff}
td.actions{white-space:nowrap}
.empty{padding:36px 18px;text-align:center;color:var(--muted)}

/* ---------- toolbar ---------- */
.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px}
.toolbar .field{margin:0;min-width:170px;flex:1 1 170px}
.toolbar .grow{flex:2 1 240px}
.toolbar .spacer{flex:1 1 auto}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.chip{
  border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;
  padding:.36rem .8rem;font-size:.82rem;cursor:pointer;font-weight:600
}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.chip .n{opacity:.7;font-size:.75rem}

/* ---------- admin shell ---------- */
.admin-shell{display:grid;grid-template-columns:246px 1fr;min-height:calc(100vh - 0px);background:var(--bg)}
.admin-side{background:var(--navy);color:#cdd8ea;padding:18px 14px}
.admin-side .side-brand{display:flex;align-items:center;gap:10px;color:#fff;padding:4px 8px 16px;border-bottom:1px solid rgba(255,255,255,.12);margin-bottom:12px}
.side-group{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:#7d90ad;padding:14px 10px 6px;font-weight:700}
.admin-side a{
  display:flex;align-items:center;justify-content:space-between;gap:8px;color:#cdd8ea;font-size:.9rem;
  padding:.55rem .7rem;border-radius:9px;margin-bottom:2px
}
.admin-side a:hover{background:rgba(255,255,255,.09);color:#fff}
.admin-side a.active{background:var(--gold);color:#241b02;font-weight:700}
.admin-side .count{background:rgba(255,255,255,.16);border-radius:999px;font-size:.7rem;padding:.1rem .45rem}
.admin-side a.active .count{background:rgba(0,0,0,.18)}
.admin-main{padding:22px;max-width:100%;overflow-x:hidden}
.admin-top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.admin-top h2{margin:0}
.crumb{font-size:.8rem;color:var(--muted)}

/* ---------- KPI cards ---------- */
.kpi{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px;box-shadow:var(--shadow-sm);position:relative;overflow:hidden}
.kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--gold)}
.kpi.k-navy::before{background:var(--navy)}
.kpi.k-ok::before{background:var(--ok)}
.kpi.k-warn::before{background:var(--warn)}
.kpi.k-bad::before{background:var(--bad)}
.kpi .k-label{font-size:.76rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700}
.kpi .k-value{font-family:var(--serif);font-size:1.6rem;color:var(--navy);font-weight:700;margin:.25rem 0 .1rem}
.kpi .k-note{font-size:.78rem;color:var(--muted)}

/* ---------- deadline list ---------- */
.deadline{display:flex;gap:12px;align-items:flex-start;padding:11px 0;border-bottom:1px solid var(--line)}
.deadline:last-child{border-bottom:0}
.deadline .d-when{min-width:112px;font-size:.8rem;font-weight:700;color:var(--navy)}
.deadline .d-body{flex:1;min-width:0}
.deadline .d-title{font-weight:600;font-size:.92rem}
.deadline .d-meta{font-size:.79rem;color:var(--muted)}
.countdown{font-weight:700;font-size:.82rem}
.cd-over{color:var(--bad)}.cd-today{color:#d97706}.cd-soon{color:var(--warn)}.cd-ok{color:var(--ok)}
.urgency-over{background:var(--bad-soft)}
.urgency-today{background:var(--warn-soft)}

/* ---------- calendar ---------- */
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.cal-head{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);text-align:center;font-weight:700;padding-bottom:4px}
.cal-day{min-height:76px;border:1px solid var(--line);border-radius:9px;padding:6px;background:#fff;font-size:.78rem}
.cal-day.out{background:#f7f9fc;color:#a9b5c8}
.cal-day.today{border-color:var(--gold);box-shadow:0 0 0 2px var(--gold-soft)}
.cal-day .dnum{font-weight:700;color:var(--navy)}
.cal-ev{display:block;margin-top:3px;font-size:.7rem;padding:.12rem .3rem;border-radius:5px;background:var(--info-soft);color:var(--info);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cal-ev.over{background:var(--bad-soft);color:var(--bad)}
.cal-ev.today{background:var(--warn-soft);color:var(--warn)}

/* ---------- toast / modal ---------- */
#toasts{position:fixed;right:16px;bottom:16px;z-index:200;display:flex;flex-direction:column;gap:10px;max-width:360px}
.toast{
  background:#fff;border-left:5px solid var(--ok);border-radius:10px;box-shadow:var(--shadow-lg);
  padding:12px 14px;font-size:.9rem;animation:slideIn .22s ease
}
.toast.error{border-left-color:var(--bad)}
.toast.info{border-left-color:var(--info)}
.toast.warn{border-left-color:var(--warn)}
.toast b{display:block;color:var(--navy);font-size:.88rem;margin-bottom:.15rem}
@keyframes slideIn{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}
.modal-back{position:fixed;inset:0;background:rgba(9,20,36,.62);z-index:150;display:flex;align-items:flex-start;justify-content:center;padding:26px 14px;overflow-y:auto}
.modal{background:#fff;border-radius:16px;box-shadow:var(--shadow-lg);width:100%;max-width:720px;animation:pop .2s ease;margin:auto}
.modal.wide{max-width:980px}
.modal-head{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}
.modal-head h3{margin:0}
.modal-body{padding:20px}
.modal-foot{padding:15px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;background:#fbfcfe;border-radius:0 0 16px 16px}
.x{background:none;border:0;font-size:1.5rem;line-height:1;color:var(--muted);cursor:pointer;padding:0 .2rem}
.x:hover{color:var(--bad)}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.99)}to{opacity:1;transform:none}}
.spinner{width:15px;height:15px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin .7s linear infinite}
.spinner.dark{border-color:rgba(11,31,58,.25);border-top-color:var(--navy)}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-block{padding:40px;text-align:center;color:var(--muted)}

/* ---------- notices ---------- */
.notice{border-radius:var(--r-sm);padding:13px 15px;font-size:.88rem;margin-bottom:16px;border:1px solid}
.notice-info{background:var(--info-soft);border-color:#cfe0fd;color:#17418f}
.notice-warn{background:var(--warn-soft);border-color:#f4ddb6;color:#7a4a00}
.notice-ok{background:var(--ok-soft);border-color:#c3e6d3;color:#136c44}
.notice-bad{background:var(--bad-soft);border-color:#f3c9c3;color:#8e2c20}
.notice b{color:inherit}

/* ---------- public specifics ---------- */
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:1.4rem}
.tick{display:flex;gap:10px;align-items:flex-start;margin-bottom:.7rem}
.tick .ic{flex:0 0 22px;height:22px;border-radius:50%;background:var(--gold-soft);color:#8b6c05;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:800}
.testimonial{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:20px;box-shadow:var(--shadow-sm)}
.testimonial .quote{font-style:italic;color:var(--ink);font-size:.95rem}
.testimonial .who{font-size:.82rem;color:var(--muted);margin-top:.7rem}
.steps{counter-reset:s;display:grid;gap:16px}
.step{display:flex;gap:14px;align-items:flex-start}
.step .n{counter-increment:s;flex:0 0 34px;height:34px;border-radius:10px;background:var(--navy);color:var(--gold-2);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700}
.step .n::before{content:counter(s)}
.partner-logo{display:flex;align-items:center;gap:12px}
.partner-mark{width:44px;height:44px;border-radius:11px;background:linear-gradient(140deg,var(--navy),var(--navy-2));color:var(--gold-2);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700;font-size:1.05rem;flex:0 0 44px}

/* ---------- footer ---------- */
.site-footer{background:var(--navy);color:#c3d0e4;padding:48px 0 22px;margin-top:10px}
.site-footer h4{color:#fff;font-family:var(--sans);font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.9rem}
.site-footer a{color:#c3d0e4;font-size:.9rem}
.site-footer a:hover{color:var(--gold-2)}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:26px}
.foot-list{list-style:none;padding:0;margin:0}
.foot-list li{margin-bottom:.45rem}
.foot-bottom{border-top:1px solid rgba(255,255,255,.13);margin-top:30px;padding-top:16px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.8rem;color:#93a4bf}
.contact-strip{display:flex;gap:12px;flex-wrap:wrap}
.contact-strip a{
  display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.16);padding:.6rem .9rem;border-radius:10px;font-size:.88rem
}
.wa-float{
