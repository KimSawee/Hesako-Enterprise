function openRateModal(rec, onSaved){
  openModal({
    title: rec ? 'Edit rate' : 'New rate card entry', wide: true,
    body: rateModal(rec),
    foot: '<button class="btn btn-outline" data-close="1">Cancel</button>' +
      '<button class="btn btn-gold" id="rrSave">' + (rec ? 'Save rate' : 'Add rate') + '</button>'
  });
  on('rrSave','click', function(){
    var item = val('rrItem'), price = val('rrPrice'), valid = val('rrValid');
    var ok = true;
    if (item.length < 2) { setErr('rrItem','Enter the item name.'); ok = false; }
    if (!/^\d+(\.\d+)?$/.test(price.replace(/,/g,''))) { setErr('rrPrice','Enter the unit price in digits.'); ok = false; }
    if (val('rrMin') && !/^\d+(\.\d+)?$/.test(val('rrMin').replace(/,/g,''))) { setErr('rrMin','Digits only.'); ok = false; }
    if (val('rrDel') && !/^\d+(\.\d+)?$/.test(val('rrDel').replace(/,/g,''))) { setErr('rrDel','Digits only.'); ok = false; }
    if (!valid) { setErr('rrValid','Choose a validity date.'); ok = false; }
    if (!ok) { toast('error','Check the highlighted fields','Some values need correcting.'); return; }
    var btn = document.getElementById('rrSave');
    btn.disabled = true; btn.innerHTML = '<span class="spinner dark"></span> Saving…';
    var row = rec || { id: uid('rt'), sample:false };
    row.item = item;
    row.category = val('rrCat');
    row.unit = val('rrUnit');
    row.unitPrice = num(price);
    row.minQty = num(val('rrMin'));
    row.supplier = val('rrSup');
    row.availability = val('rrAvail');
    row.tax = val('rrTax');
    row.deliveryCharge = num(val('rrDel'));
    row.validUntil = valid;
    row.notes = val('rrNotes');
    row.indicative = document.getElementById('rrInd').checked;
    row.updated = todayISO();
    if (!rec) State.rates.unshift(row);
    logActivity((rec ? 'Updated' : 'Added') + ' rate: ' + row.item);
    if (!save()) { toast('error','Not saved','Local storage is blocked in this browser.'); return; }
    closeModal();
    toast('ok', rec ? 'Rate updated' : 'Rate added', row.item + ' — ' + money(row.unitPrice) + ' per ' + row.unit);
    onSaved();
  });
}
