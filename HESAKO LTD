H.afterRenderTenderForm = function(){
  var q = currentRoute().query;
  var editing = q.id ? State.tenders.filter(function(t){ return t.id === q.id; })[0] : null;
  var form = document.getElementById('tenderForm');
  if (!form) return;
  var cl = editing ? (editing.documentsChecklist || []).slice() : [];
  var tasks = editing ? JSON.parse(JSON.stringify(editing.tasks || [])) : [];
  var attachments = editing ? (editing.attachments || []).slice() : [];

  function paintChecklist(){
    document.getElementById('clList').innerHTML = cl.length ? cl.map(function(d,i){
      return '<div class="check"><span style="flex:1;font-size:.88rem">' + esc(d) + '</span>' +
        '<button class="btn btn-xs btn-danger" data-docdel="' + i + '" type="button">Remove</button></div>';
    }).join('') : '<p class="muted" style="font-size:.86rem;margin:0">No documents listed yet.</p>';
  }
  function paintTasks(){
    document.getElementById('taskList').innerHTML = tasks.length ? tasks.map(function(tk,i){
      return '<div class="check"><input type="checkbox" data-task="' + i + '"' + (tk.done ? ' checked' : '') + '>' +
        '<span style="flex:1;font-size:.9rem">' + esc(tk.text) + '</span>' +
        '<button class="btn btn-xs btn-danger" type="button" data-taskdel="' + i + '">Remove</button></div>';
    }).join('') : '<p class="muted" style="font-size:.88rem;margin:0">No tasks yet.</p>';
  }
  paintTasks();

  /* clicks are delegated from the freshly-rendered admin container because the
     Save and Cancel buttons sit in the page header, outside the form element */
  var clickHost = (H.viewClickHost && H.viewClickHost()) || form;
  clickHost.addEventListener('click', function(e){
    var t = e.target;
    if (t.id === 'clAdd') { var v = val('clNew'); if (v) { cl.push(v); document.getElementById('clNew').value = ''; paintChecklist(); } return; }
    if (t.hasAttribute && t.hasAttribute('data-docdel')) { cl.splice(num(t.getAttribute('data-docdel')),1); paintChecklist(); return; }
    if (t.id === 'taskAdd') { var tv = val('taskNew'); if (tv) { tasks.push({ id: uid('tk'), text: tv, done:false }); document.getElementById('taskNew').value = ''; paintTasks(); } return; }
    if (t.hasAttribute && t.hasAttribute('data-taskdel')) { tasks.splice(num(t.getAttribute('data-taskdel')),1); paintTasks(); return; }
    if (t.id === 'tfCancel' || t.id === 'tfCancel2') { go('/admin/tenders'); return; }
    if (t.id === 'tfSave' || t.id === 'tfSave2') { saveTender(); return; }
  });
  form.addEventListener('change', function(e){
    if (e.target.hasAttribute && e.target.hasAttribute('data-task')) tasks[num(e.target.getAttribute('data-task'))].done = e.target.checked;
  });

  function saveTender(){
    clearErrs(form);
    var title = val('fTitle'), subDate = val('fSubDate'), subTime = val('fSubTime'), ok = true;
    if (title.length < 4) { setErr('fTitle','Enter the tender title.'); ok = false; }
    if (!subDate) { setErr('fSubDate','Enter the submission deadline date.'); ok = false; }
    if (!/^\d{2}:\d{2}$/.test(subTime)) { setErr('fSubTime','Enter the submission time.'); ok = false; }
    ['fEst','fQRate','fQTotal','fOutcome'].forEach(function(id){
      var v = val(id);
      if (v && !/^\d+(\.\d+)?$/.test(v.replace(/,/g,''))) { setErr(id,'Use digits only, without commas.'); ok = false; }
    });
    if (val('fLink') && !/^https?:\/\//i.test(val('fLink'))) { setErr('fLink','Enter a full link starting with http:// or https://'); ok = false; }
    if (!ok) { toast('error','Check the highlighted fields','Some values need correcting before saving.'); return; }
    if (!can('tenders')) { toast('error','Not permitted','Your role does not allow editing tender records.'); return; }

    var btn = document.getElementById('tfSave2');
    btn.disabled = true; btn.innerHTML = '<span class="spinner dark"></span> Saving…';

    function persist(){
      var rec = editing || { id: uid('tn'), createdAt: todayISO(), sample:false, archived:false };
      rec.title = title;
      rec.description = val('fDesc');
      rec.buyer = val('fBuyer');
      rec.refNo = val('fRef');
      rec.category = val('fCat');
      rec.publicationDate = val('fPub');
      rec.siteVisitDate = val('fSite');
      rec.questionDeadline = val('fQDead');
      rec.submissionDate = subDate;
      rec.submissionTime = subTime;
      rec.openingDate = val('fOpen');
      rec.estimatedValue = num(val('fEst'));
      rec.quotedRate = num(val('fQRate'));
      rec.quotedTotal = num(val('fQTotal'));
      rec.partner = val('fPartner');
      rec.requirements = val('fReq');
      rec.documentsChecklist = cl;
      rec.submissionMethod = val('fMethod');
      rec.sourceLink = val('fLink');
      rec.assignedTo = val('fAssigned');
      rec.notes = val('fNotes');
      rec.status = val('fStatus');
      rec.outcome = val('fOutcomeText');
      rec.contractValue = num(val('fOutcome'));
      rec.archived = document.getElementById('fArch').checked;
      rec.tasks = tasks;
      rec.attachments = attachments;
      rec.updatedAt = todayISO();
      if (!editing) State.tenders.unshift(rec);
      logActivity((editing ? 'Updated' : 'Created') + ' tender record: ' + rec.title);
      var saved = save();
      btn.disabled = false; btn.textContent = editing ? 'Save changes' : 'Create record';
      if (!saved) { toast('error','Not saved','This browser blocked local storage, so the record could not be stored.'); return; }
      toast('ok', editing ? 'Tender updated' : 'Tender record created', rec.title);
      var c = countdownLabel(rec.submissionDate, rec.submissionTime);
      toast(c.cls === 'cd-over' ? 'warn' : 'info','Deadline: ' + c.text, fmtDate(rec.submissionDate) + ' at ' + rec.submissionTime + ' EAT');
      go('/admin/tender?id=' + rec.id);
    }

    var fi = document.getElementById('fAttach');
    if (fi && fi.files && fi.files.length) {
      var files = Array.prototype.slice.call(fi.files);
      var pending = files.length;
      files.forEach(function(f){
        if (f.size <= 200 * 1024) {
          var r = new FileReader();
          r.onload = function(){ attachments.push({ name: f.name, size: f.size, data: String(r.result || '') }); if (--pending === 0) persist(); };
          r.onerror = function(){ attachments.push({ name: f.name, size: f.size, data:'' }); if (--pending === 0) persist(); };
          r.readAsDataURL(f);
        } else {
          attachments.push({ name: f.name + ' (' + Math.round(f.size/1024) + 'KB — not embedded)', size: f.size, data:'' });
          if (--pending === 0) persist();
        }
      });
      return;
    }
    persist();
  }
};

