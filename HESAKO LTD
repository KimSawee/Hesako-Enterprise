    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('cEmail'))) { setErr('cEmail','Enter a valid email address.'); errs++; }
    if (!val('cTopic')) { setErr('cTopic','Choose a topic.'); errs++; }
    if (val('cMsg').length < 8) { setErr('cMsg','Please write a short message.'); errs++; }
    if (errs) { toast('error','Please check the form','Highlighted fields need attention.'); return; }
    var ref = refNo('HES');
    var order = {
      id: uid('or'), ref: ref, type: val('cTopic'), customer: val('cName'), contactPerson: val('cName'),
      phone: val('cPhone'), email: val('cEmail'), service: 'Website contact form', qty: '', location: '',
      requiredDate: '', budget: 0, specifications: val('cMsg'), attachmentName: '', attachmentData: '',
      status: 'New', createdAt: todayISO(), updatedAt: todayISO(), notes: 'Submitted via the contact page.', sample: false
    };
    State.orders.unshift(order);
    logActivity('Contact form enquiry ' + ref + ' from ' + order.customer);
    if (save()) {
      showOrderConfirmation(order);
      this.reset();
      toast('ok','Enquiry sent','Reference ' + ref + ' — we will be in touch.');
    } else {
      toast('error','Could not save','This browser blocked local storage. Please send the message on WhatsApp or email.');
    }
  });
}
