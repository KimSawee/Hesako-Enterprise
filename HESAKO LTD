          '<a class="btn btn-outline btn-block" href="#/admin/rates">Update the rate card</a>' +
          '<a class="btn btn-outline btn-block" href="#/admin/reports">Open reports</a>' +
          '<a class="btn btn-outline btn-block" href="#/admin/system">Backup / export data</a>' +
          '</div></div></div>' +
      '</div>' +
    '</div>';
};

/* ------------------------------ tender list ------------------------------ */
var tenderFilter = { q:'', status:'', cat:'', bucket:'', assigned:'', archived:false };
var tenderSort = { key:'submissionDate', dir:1 };
H.adminTenders = function(q){
  if (q && q.q) tenderFilter.q = q.q;
  return adminHead('Tender records', State.tenders.filter(function(t){return !t.archived;}).length + ' active records · sample records are labelled',
    '<button class="btn btn-outline btn-sm" id="tExport">Export CSV</button>' +
    '<a class="btn btn-gold btn-sm" href="#/admin/tender-new">+ New tender</a>') +
  '<div id="tenderTable"></div>';
};
H.renderTenderTable = function(host){
  var cats = {}, staff = {};
  State.tenders.forEach(function(t){ if (t.category) cats[t.category] = 1; if (t.assignedTo) staff[t.assignedTo] = 1; });
  var rows = State.tenders.filter(function(t){
    if (!!t.archived !== !!tenderFilter.archived) return false;
    if (tenderFilter.status && t.status !== tenderFilter.status) return false;
    if (tenderFilter.cat && t.category !== tenderFilter.cat) return false;
    if (tenderFilter.assigned && t.assignedTo !== tenderFilter.assigned) return false;
    if (tenderFilter.q) {
      var hay = [t.title,t.description,t.buyer,t.refNo,t.category,t.assignedTo,(t.requirements||'')].join(' ').toLowerCase();
      if (hay.indexOf(tenderFilter.q.toLowerCase()) === -1) return false;
    }
    if (tenderFilter.bucket) {
      var d = daysLeft(t.submissionDate, t.submissionTime);
      var bucket = d === null ? 'none' : d < 0 ? 'overdue' : d < 1 ? 'today' : d <= 3 ? 'd3' : d <= 7 ? 'd7' : 'later';
      if (bucket !== tenderFilter.bucket) return false;
    }
    return true;
  });
  var dir = tenderSort.dir;
  rows.sort(function(a,b){
    var k = tenderSort.key, av = a[k], bv = b[k];
    if (k === 'submissionDate') { av = deadlineMs(a.submissionDate, a.submissionTime) || 0; bv = deadlineMs(b.submissionDate, b.submissionTime) || 0; }
    if (k === 'estimatedValue' || k === 'quotedTotal') { av = num(av); bv = num(bv); }
    if (av === undefined) av = ''; if (bv === undefined) bv = '';
    if (typeof av === 'string') return String(av).localeCompare(String(bv)) * dir;
    return (av > bv ? 1 : av < bv ? -1 : 0) * dir;
  });
  H.__tenderRows = rows;

  function sortTh(key, label){
    var on = tenderSort.key === key;
    return '<th data-sortkey="' + key + '">' + esc(label) + (on ? ' <span class="arrow">' + (tenderSort.dir === 1 ? '▲' : '▼') + '</span>' : '') + '</th>';
  }

  host.innerHTML =
  '<div class="toolbar">' +
    '<div class="field grow"><label for="tQ">Search</label><input id="tQ" type="search" placeholder="Title, buyer, reference, category…" value="' + esc(tenderFilter.q) + '"></div>' +
    '<div class="field"><label for="tStatus">Status</label><select id="tStatus"><option value="">All statuses</option>' +
      TENDER_STATUSES.map(function(s){ return '<option' + (tenderFilter.status===s?' selected':'') + '>' + esc(s) + '</option>'; }).join('') + '</select></div>' +
    '<div class="field"><label for="tCat">Category</label><select id="tCat"><option value="">All categories</option>' +
      Object.keys(cats).sort().map(function(c){ return '<option' + (tenderFilter.cat===c?' selected':'') + '>' + esc(c) + '</option>'; }).join('') + '</select></div>' +
    '<div class="field"><label for="tAssigned">Assigned to</label><select id="tAssigned"><option value="">Anyone</option>' +
      Object.keys(staff).sort().map(function(s){ return '<option' + (tenderFilter.assigned===s?' selected':'') + '>' + esc(s) + '</option>'; }).join('') + '</select></div>' +
    '<div class="field"><label for="tBucket">Deadline</label><select id="tBucket">' +
      [['','Any deadline'],['overdue','Overdue'],['today','Due today'],['d3','Within 3 days'],['d7','Within 7 days'],['later','Later'],['none','No date set']].map(function(o){
        return '<option value="' + o[0] + '"' + (tenderFilter.bucket===o[0]?' selected':'') + '>' + esc(o[1]) + '</option>';
      }).join('') + '</select></div>' +
    '<div class="field"><label>&nbsp;</label><button class="btn btn-outline" id="tClear">Clear filters</button></div>' +
  '</div>' +
  '<div class="filters">' +
    '<button class="chip' + (!tenderFilter.archived ? ' on' : '') + '" data-arch="0">Active <span class="n">(' + State.tenders.filter(function(t){return !t.archived;}).length + ')</span></button>' +
    '<button class="chip' + (tenderFilter.archived ? ' on' : '') + '" data-arch="1">Archived <span class="n">(' + State.tenders.filter(function(t){return t.archived;}).length + ')</span></button>' +
    '<span class="muted" style="font-size:.85rem;align-self:center;margin-left:8px">' + rows.length + ' record' + (rows.length===1?'':'s') + ' shown · click a column heading to sort</span>' +
  '</div>' +
  (rows.length ?
  '<div class="panel"><div class="table-wrap"><table><thead><tr>' +
    sortTh('title','Tender') + sortTh('buyer','Buyer / entity') + sortTh('refNo','Reference') +
    sortTh('estimatedValue','Estimated value') + sortTh('quotedTotal','Quoted total') +
    sortTh('submissionDate','Submission deadline') + sortTh('status','Status') + sortTh('assignedTo','Assigned') +
    '<th class="no-sort">Actions</th></tr></thead><tbody>' +
    rows.map(function(t){
      var c = countdownLabel(t.submissionDate, t.submissionTime);
      var dl = daysLeft(t.submissionDate, t.submissionTime);
      var over = dl !== null && dl < 0;
      return '<tr' + (over ? ' style="background:#fffafa"' : '') + '>' +
        '<td><a href="#/admin/tender?id=' + esc(t.id) + '"><strong>' + esc(t.title) + '</strong></a>' + sampleTag(t) +
          '<div class="muted" style="font-size:.78rem">' + esc(t.category || '—') + (t.partner ? ' · ' + esc(t.partner) : '') + '</div></td>' +
        '<td>' + esc(t.buyer || '—') + '</td>' +
        '<td class="mono" style="font-size:.8rem">' + esc(t.refNo || '—') + '</td>' +
        '<td>' + (num(t.estimatedValue) ? money0(t.estimatedValue) : '—') + '</td>' +
        '<td>' + (num(t.quotedTotal) ? money0(t.quotedTotal) : '—') + '</td>' +
        '<td>' + esc(fmtDate(t.submissionDate)) + '<div class="muted" style="font-size:.76rem">' + esc(t.submissionTime || '23:59') + ' EAT</div>' +
          '<div class="countdown ' + c.cls + '" style="font-size:.75rem">' + esc(c.text) + '</div></td>' +
        '<td>' + statusBadge(t.status) + '</td>' +
        '<td style="font-size:.84rem">' + esc(t.assignedTo || '—') + '</td>' +
        '<td class="actions">' +
          '<button class="btn btn-xs btn-outline" data-edit="' + esc(t.id) + '">Edit</button> ' +
          '<button class="btn btn-xs btn-outline" data-arch-toggle="' + esc(t.id) + '">' + (t.archived ? 'Restore' : 'Archive') + '</button> ' +
          '<button class="btn btn-xs btn-danger" data-del="' + esc(t.id) + '">Delete</button>' +
        '</td></tr>';
    }).join('') + '</tbody></table></div></div>'
  : emptyBox('No tender records match','Adjust the filters, or add a new tender record.',
      '<div class="btn-row" style="justify-content:center;margin-top:12px"><a class="btn btn-gold btn-sm" href="#/admin/tender-new">+ New tender</a>' +
      '<button class="btn btn-outline btn-sm" id="tClear2">Clear filters</button></div>'));
};
H.afterRenderTenders = function(){
  var host = document.getElementById('tenderTable');
  if (!host) return;
  H.renderTenderTable(host);
  on('tQ','input', debounce(function(){ tenderFilter.q = val('tQ'); H.renderTenderTable(host); }, 220));
  on('tStatus','change', function(){ tenderFilter.status = val('tStatus'); H.renderTenderTable(host); });
  on('tCat','change', function(){ tenderFilter.cat = val('tCat'); H.renderTenderTable(host); });
  on('tAssigned','change', function(){ tenderFilter.assigned = val('tAssigned'); H.renderTenderTable(host); });
  on('tBucket','change', function(){ tenderFilter.bucket = val('tBucket'); H.renderTenderTable(host); });
  function clearAll(){ tenderFilter = { q:'', status:'', cat:'', bucket:'', assigned:'', archived:false }; H.renderTenderTable(host); }
  on('tClear','click', clearAll);
  var c2 = document.getElementById('tClear2');
  if (c2) c2.addEventListener('click', clearAll);
  on('tExport','click', function(){ H.exportTendersCSV(H.__tenderRows || State.tenders); });
  host.addEventListener('click', function(e){
    var el = e.target.closest ? e.target.closest('[data-sortkey]') : null;
    if (el) {
      var k = el.getAttribute('data-sortkey');
      if (tenderSort.key === k) tenderSort.dir = -tenderSort.dir; else { tenderSort.key = k; tenderSort.dir = 1; }
      H.renderTenderTable(host); return;
    }
    var arch = e.target.closest ? e.target.closest('[data-arch]') : null;
    if (arch) { tenderFilter.archived = arch.getAttribute('data-arch') === '1'; H.renderTenderTable(host); return; }
    var ed = e.target.closest ? e.target.closest('[data-edit]') : null;
    if (ed) { go('/admin/tender-new?id=' + ed.getAttribute('data-edit')); return; }
    var at = e.target.closest ? e.target.closest('[data-arch-toggle]') : null;
    if (at) {
      var tt = State.tenders.filter(function(x){ return x.id === at.getAttribute('data-arch-toggle'); })[0];
      if (tt) { tt.archived = !tt.archived; logActivity((tt.archived ? 'Archived' : 'Restored') + ' tender: ' + tt.title); save(); toast('ok', tt.archived ? 'Tender archived' : 'Tender restored', tt.title); H.renderTenderTable(host); }
      return;
    }
    var dle = e.target.closest ? e.target.closest('[data-del]') : null;
    if (dle) {
      var id = dle.getAttribute('data-del');
      var rec = State.tenders.filter(function(x){ return x.id === id; })[0];
      confirmAction('Delete tender record?','“' + (rec ? rec.title : '') + '” will be permanently removed from these records. This cannot be undone. Consider archiving instead.', function(){
        State.tenders = State.tenders.filter(function(x){ return x.id !== id; });
        logActivity('Deleted tender: ' + (rec ? rec.title : id)); save(); toast('ok','Tender deleted', rec ? rec.title : ''); H.renderTenderTable(host);
      }, 'Delete permanently');
    }
  });
};
H.exportTendersCSV = function(list){
  list = list || State.tenders;
  var rows = [['Title','Reference','Buyer','Category','Publication','Questions close','Submission date','Submission time EAT','Opening','Estimated value','Quoted rate','Quoted total','Partner','Status','Outcome','Contract value','Assigned','Archived','Sample data','Notes']];
  list.forEach(function(t){
    rows.push([t.title, t.refNo, t.buyer, t.category, t.publicationDate, t.questionDeadline, t.submissionDate, t.submissionTime || '23:59',
      t.openingDate, t.estimatedValue, t.quotedRate, t.quotedTotal, t.partner, t.status, t.outcome, t.contractValue, t.assignedTo,
      t.archived ? 'Yes' : 'No', t.sample ? 'Yes' : 'No', t.notes]);
  });
  if (downloadFile('hesako-tenders-' + todayISO() + '.csv', toCSV(rows))) toast('ok','CSV exported', (rows.length - 1) + ' tender record(s) exported.');
};
window.HESAKO.renderAdminArea = renderAdminArea;
})();
</script>




<script>
