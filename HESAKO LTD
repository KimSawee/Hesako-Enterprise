          p.publicApproved ? (p.brand || p.name) + ' now appears in the public directory.' : (p.brand || p.name) + ' is no longer public.');
        reload();
      }
      return;
    }
    var dl = t.closest && t.closest('[data-pdel]');
    if (dl) {
      var id = dl.getAttribute('data-pdel');
      var rec = State.partners.filter(function(x){ return x.id === id; })[0];
      confirmAction('Delete partner?','“' + (rec ? (rec.brand || rec.name) : '') + '” and its recorded agreement details will be deleted.', function(){
        State.partners = State.partners.filter(function(x){ return x.id !== id; });
        logActivity('Deleted partner: ' + (rec ? (rec.brand || rec.name) : id)); save(); toast('ok','Partner deleted',''); reload();
      }, 'Delete partner');
    }
  });
};

