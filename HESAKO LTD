    }).join('') : '<tr><td colspan="6"><div class="empty">No line items yet. Add from the rate card or add a blank line.</div></td></tr>';
    recalc();
  }
  function recalc(){
    var t = quoteTotals(quote);
    var s = document.getElementById('qbSubtotal'); if (s) s.textContent = money(t.subtotal);
    var v = document.getElementById('qbVatAmt'); if (v) v.textContent = quote.applyVat ? money(t.vat) + '  (' + quote.vatRate + '%)' : 'Not applicable';
    var tl = document.getElementById('qbTotal'); if (tl) tl.textContent = money(t.total);
    var ind = (quote.lines || []).some(function(l){ return l.indicative; }) || !quote.lines.length;
    var n = document.getElementById('qbIndNotice');
    if (n) {
      n.className = 'notice ' + (ind ? 'notice-warn' : 'notice-ok');
      n.style.margin = '14px 0 0';
      n.innerHTML = ind
        ? '<b>Indicative pricing.</b> At least one line uses a working (indicative) rate. Confirm supplier stock and price before the customer relies on this quotation.'
        : '<b>Confirmed rates.</b> Every line on this quotation uses a rate marked confirmed by the supplier.';
    }
    quote.indicative = ind;
  }
  paintLines();

  var host = document.getElementById('quoteBuilder');
  host.addEventListener('input', function(e){
    var t = e.target;
    if (t.hasAttribute && t.hasAttribute('data-lf')) {
      var i = num(t.getAttribute('data-i')), f = t.getAttribute('data-lf');
      quote.lines[i][f] = (f === 'item' || f === 'unit') ? t.value : t.value;
      var sum = document.getElementById('lsum' + i);
      if (sum) sum.textContent = money(num(quote.lines[i].qty) * num(quote.lines[i].unitPrice));
      recalc(); return;
    }
    if (t.id === 'qbDel' || t.id === 'qbVatRate') { quote.delivery = num(val('qbDel')); quote.vatRate = num(val('qbVatRate')) || 16; recalc(); }
  });
  host.addEventListener('change', function(e){
    if (e.target.id === 'qbVat') { quote.applyVat = e.target.checked; recalc(); }
    if (e.target.id === 'qbStatus') quote.status = val('qbStatus');
    if (e.target.id === 'qbCustSel') {
      var c = State.customers.filter(function(x){ return x.id === val('qbCustSel'); })[0];
      if (c) {
        document.getElementById('qbCustomer').value = c.name;
        document.getElementById('qbContact').value = c.contactPerson || '';
        document.getElementById('qbEmail').value = c.email || '';
        document.getElementById('qbPhone').value = c.phone || '';
        document.getElementById('qbLocation').value = c.location || '';
        quote.customer = c.name; quote.contactPerson = c.contactPerson; quote.email = c.email;
        quote.phone = c.phone; quote.location = c.location;
      }
    }
  });
  /* the Save / Cancel buttons sit in the page header, outside the builder, so
     clicks are delegated from the freshly-rendered admin container */
  var clickHost = (H.viewClickHost && H.viewClickHost()) || host;
  clickHost.addEventListener('click', function(e){
    var t = e.target;
    if (t.id === 'qbAddRate') {
      var r = State.rates.filter(function(x){ return x.id === val('qbRatePick'); })[0];
      if (!r) { toast('info','Pick a rate','Select an item from the rate card first.'); return; }
      quote.lines.push({ item: r.item, unit: r.unit, qty: num(r.minQty) || 1, unitPrice: num(r.unitPrice), indicative: !!r.indicative });
      paintLines(); return;
    }
    if (t.id === 'qbAddBlank') { quote.lines.push({ item:'', unit:'piece', qty:1, unitPrice:0, indicative:true }); paintLines(); return; }
    if (t.hasAttribute && t.hasAttribute('data-ldel')) { quote.lines.splice(num(t.getAttribute('data-ldel')),1); paintLines(); return; }
    if (t.id === 'qCancel') { go('/admin/quotes'); return; }
    if (t.id === 'qSaveDraft') { pull(); quote.status = 'Draft'; saveQuote(false); return; }
    if (t.id === 'qSavePrint') { pull(); saveQuote(true); return; }
  });

  function saveQuote(view){
    if (!quote.customer || quote.customer.length < 2) {
      setErr('qbCustomer','Enter the customer name.');
      toast('error','Customer required','Enter the customer or business name before saving.');
      return;
    }
    if (!quote.validUntil) { setErr('qbValid','Choose the validity date.'); toast('error','Validity required','Choose the date the quotation stops being valid.'); return; }
    if (!quote.lines.length) { toast('error','No line items','Add at least one line from the rate card or as a blank line.'); return; }
    var bad = quote.lines.filter(function(l){ return !l.item || !String(l.item).trim(); });
    if (bad.length) { toast('error','Item description missing','Every line needs a description.'); return; }
    if (!can('quotes')) { toast('error','Not permitted','Your role does not allow creating quotations.'); return; }
    quote.updatedAt = todayISO();
    var t = quoteTotals(quote);
    quote.total = t.total; quote.subtotal = t.subtotal;
    var idx = -1;
    State.quotes.forEach(function(x,i){ if (x.id === quote.id) idx = i; });
    if (idx === -1) State.quotes.unshift(quote); else State.quotes[idx] = quote;
    logActivity('Saved quotation ' + quote.ref + ' for ' + quote.customer + ' — ' + money(t.total));
    if (!save()) { toast('error','Not saved','Local storage is blocked in this browser.'); return; }
    if (fromOrder && fromOrder.status === 'New') {
      fromOrder.status = 'Quotation Sent'; fromOrder.updatedAt = todayISO();
      save();
      toast('info','Order status updated','Website order ' + fromOrder.ref + ' moved to “Quotation Sent”.');
    }
    toast('ok','Quotation saved', quote.ref + ' — total ' + money(t.total));
    if (view) go('/admin/quote-view?id=' + quote.id);
    else go('/admin/quotes');
  }
};

