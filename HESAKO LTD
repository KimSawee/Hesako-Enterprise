H.afterAdminRender = function(view){
  if (view === 'tenders') H.afterRenderTenders();
  else if (view === 'tender-new') H.afterRenderTenderForm();
  else if (view === 'calendar') H.afterRenderCalendar();
  else if (view === 'rates') H.afterRenderRates();
  else if (view === 'quote-new') H.afterRenderQuoteBuilder();
  else if (view === 'quote-view') H.afterRenderQuoteView();
  else if (view === 'quotes') H.afterRenderQuotes();
  else if (view === 'partners') H.afterRenderPartners();
  else if (view === 'orders') H.afterRenderOrders();
  else if (view === 'customers') H.afterRenderCustomers();
  else if (view === 'reports') H.afterRenderReports();
  else if (view === 'settings') H.afterRenderSettings();
  else if (view === 'users') H.afterRenderUsers();
  else if (view === 'system') H.afterRenderSystem();

  on('dashExport','click', function(){
    var b = H.dueBuckets();
    var rows = [['HESAKO ENTERPRISE LTD — dashboard summary'], ['Generated', nowStamp()], [],
      ['Metric','Value'],
      ['Tenders recorded', State.tenders.filter(function(t){ return !t.archived; }).length],
      ['Overdue submissions', b.overdue.length],
      ['Due today', b.today.length],
      ['Due within 3 days', b.d3.length],
      ['Due within 7 days', b.d7.length],
      ['Submitted / under evaluation', State.tenders.filter(function(t){ return ['Submitted','Under Evaluation'].indexOf(t.status) !== -1; }).length],
      ['Awarded', State.tenders.filter(function(t){ return t.status === 'Awarded'; }).length],
      ['Unsuccessful', State.tenders.filter(function(t){ return t.status === 'Unsuccessful'; }).length],
      ['Total quoted value (KES) — estimate', State.tenders.reduce(function(a, t){ return a + num(t.quotedTotal); }, 0)],
      ['Confirmed order value (KES) — actual', State.orders.filter(function(o){ return ['Confirmed','In Progress','Completed'].indexOf(o.status) !== -1; }).reduce(function(a, o){ return a + num(o.budget); }, 0)],
      ['Orders awaiting review', State.orders.filter(function(o){ return ['New','Under Review'].indexOf(o.status) !== -1; }).length],
      ['Active brand partnerships', State.partners.filter(function(p){ return p.status === 'Active'; }).length],
      ['Customers on record', State.customers.length]
    ];
    if (downloadFile('hesako-dashboard-' + todayISO() + '.csv', toCSV(rows))) toast('ok','Summary exported','Dashboard summary downloaded as CSV.');
  });

  var main = (H.viewClickHost && H.viewClickHost()) || document.getElementById('main');
  main.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('[data-taskdone]');
    if (!b) return;
    var parts = b.getAttribute('data-taskdone').split('|');
    var tender = State.tenders.filter(function(t){ return t.id === parts[0]; })[0];
    if (!tender) return;
    var task = (tender.tasks || []).filter(function(t){ return t.id === parts[1]; })[0];
    if (!task) return;
    task.done = !task.done;
    logActivity((task.done ? 'Completed' : 'Reopened') + ' task “' + task.text + '” on ' + tender.title);
    save();
    toast('ok', task.done ? 'Task completed' : 'Task reopened', task.text);
    render();
  });
};
})();
</script>




<script>
/* ==========================================================================
   BOOT — start the application
   ========================================================================== */
(function () {
'use strict';

/* storage availability probe (some embedded previews block local storage) */
try {
  window.localStorage.setItem('__hesako_probe__', '1');
  window.localStorage.removeItem('__hesako_probe__');
  StorageOK = true;
} catch (e) {
  StorageOK = false;
}

try {
  loadState();
  loadSession();
} catch (e) {
  State = seedState();
  StorageOK = false;
  setTimeout(function(){ toast('error', 'Start-up problem', 'The stored records could not be read, so a fresh set of sample records was loaded.'); }, 400);
}

/* seed demo activity so the dashboard log is not empty on first open */
if (!State.activity || !State.activity.length) {
  State.activity = [
    { at: nowStamp(), text: 'System opened with sample/demo records loaded', by: 'System' },
    { at: nowStamp(), text: 'Sample tenders, rates, partners and orders are clearly labelled and can be removed from Data & backups', by: 'System' }
  ];
  save();
}

/* mobile navigation */
var burger = document.getElementById('burger');
var nav = document.getElementById('mainNav');
if (burger && nav) {
  burger.addEventListener('click', function () {
    var open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
}

/* a stub in one place keeps every "go to the dashboard" link honest */
var adminLink = document.getElementById('adminNavLink');
if (adminLink) {
  adminLink.addEventListener('click', function () {
    /* the hash change triggers render(); nothing else needed */
  });
}

/* close the mobile menu and any open modal after navigating */
window.addEventListener('hashchange', function () {
  closeModal();
  render();
});

/* first paint */
render();

/* warn once if the browser cannot store data, so nobody believes a save
   happened when it did not */
if (!StorageOK) {
  setTimeout(function () {
    toast('warn', 'Records will not be saved',
      'This browser blocked local storage. Open the file directly in a browser tab (not an embedded preview) so records persist between visits.');
  }, 900);
}
})();
</script>
</body>
</html>

