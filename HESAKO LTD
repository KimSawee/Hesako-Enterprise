        '<div class="field"><label for="stPhone">Phone</label><input id="stPhone" value="' + esc(c.phone) + '"><div class="err"></div></div>' +
        '<div class="field"><label for="stWa">WhatsApp</label><input id="stWa" value="' + esc(c.whatsapp) + '"><div class="err"></div></div>' +
        '<div class="field"><label for="stEmail">Email</label><input id="stEmail" type="email" value="' + esc(c.email) + '"><div class="err">Enter a valid email.</div></div>' +
        '<div class="field"><label for="stPostal">Postal address</label><input id="stPostal" value="' + esc(c.postal) + '"><div class="err"></div></div>' +
        '<div class="field span2"><label for="stHours">Working hours</label><input id="stHours" value="' + esc(c.hours) + '"><div class="err"></div></div>' +
      '</div>' +
      '<button class="btn btn-gold" id="stSaveCompany">Save company details</button>' +
    '</div></div>' +
    '<div>' +
      '<div class="panel"><div class="panel-head"><h3>Quotation defaults</h3></div><div class="panel-body">' +
        '<div class="form-grid">' +
          '<div class="field"><label for="stVat">VAT rate (%)</label><input id="stVat" inputmode="decimal" value="' + esc(s.vatRate) + '"><div class="err">Digits only.</div></div>' +
