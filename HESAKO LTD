        '<textarea id="impText" style="min-height:180px" placeholder="item,category,unit,unitPrice\nA4 copier paper,Stationery,ream,620"></textarea>' +
        '<div class="check" style="margin-top:10px"><input type="checkbox" id="impConfirmed"><label for="impConfirmed" style="font-weight:400;margin:0;font-size:.86rem">These are confirmed supplier rates (unticked = indicative)</label></div>',
      foot: '<button class="btn btn-outline" data-close="1">Cancel</button><button class="btn btn-gold" id="impGo">Import rates</button>'
    });
    on('impGo','click', function(){
      var txt = document.getElementById('impText').value.trim();
      if (!txt) { toast('error','Nothing to import','Paste CSV rows first.'); return; }
      var lines = txt.split(/\r?\n/).filter(function(l){ return l.trim(); });
      var head = lines.shift().split(',').map(function(h){ return h.trim(); });
      var confirmed = document.getElementById('impConfirmed').checked;
      var added = 0;
      lines.forEach(function(l){
        var cells = l.split(',');
        var o = {};
