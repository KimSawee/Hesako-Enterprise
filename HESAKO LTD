    if (ed) { openRateModal(State.rates.filter(function(r){ return r.id === ed.getAttribute('data-redit'); })[0], reload); return; }
    var qq = t.closest && t.closest('[data-rquote]');
    if (qq) { go('/admin/quote-new?rate=' + qq.getAttribute('data-rquote')); return; }
    var dl = t.closest && t.closest('[data-rdel]');
    if (dl) {
      var id = dl.getAttribute('data-rdel');
      var rec = State.rates.filter(function(r){ return r.id === id; })[0];
      confirmAction('Delete this rate?','“' + (rec ? rec.item : '') + '” will be removed from the rate card.', function(){
        State.rates = State.rates.filter(function(r){ return r.id !== id; });
        logActivity('Deleted rate: ' + (rec ? rec.item : id)); save(); toast('ok','Rate deleted', rec ? rec.item : ''); reload();
      }, 'Delete rate');
    }
  });
};

/* ------------------------------ quote maths ------------------------------ */
function quoteTotals(q){
  var subtotal = 0;
  (q.lines || []).forEach(function(l){ subtotal += num(l.qty) * num(l.unitPrice); });
  var delivery = num(q.delivery);
  var taxable = subtotal + delivery;
  var vat = q.applyVat ? taxable * (num(q.vatRate) / 100) : 0;
  return { subtotal: subtotal, delivery: delivery, vat: vat, total: taxable + vat };
}
H.quoteTotals = quoteTotals;
