      .concat(['','WITHIN 3 DAYS (' + b.d3.length + ')']).concat(b.d3.map(function(t){ return '- ' + t.title + ' — ' + fmtDate(t.submissionDate); }))
      .concat(['','WITHIN 7 DAYS (' + b.d7.length + ')']).concat(b.d7.map(function(t){ return '- ' + t.title + ' — ' + fmtDate(t.submissionDate); }))
      .concat(['','Generated by the HESAKO tender dashboard.']);
    var bodyText = L.join('\n');
    openModal({
      title: 'Deadline digest', wide: true,
      body: '<p class="muted" style="font-size:.88rem">Copy this into an email, or open it pre-filled in your mail app. Automatic sending needs the platform’s scheduled automation or a mail server.</p>' +
        '<textarea style="min-height:270px" id="digestText">' + esc(bodyText) + '</textarea>',
