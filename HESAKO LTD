H.afterRenderSystem = function(){
  on('sysBackup','click', function(){
    var payload = { exportedAt: new Date().toISOString(), timezone: TZ, company: COMPANY.name, version: State.version, data: State };
    if (downloadFile('hesako-backup-' + todayISO() + '.json', JSON.stringify(payload, null, 2), 'application/json')) {
      logActivity('Downloaded full JSON backup'); save();
      toast('ok','Backup downloaded','Keep the JSON file somewhere safe — it contains customer and partner data.');
    }
  });
  on('sysTenders','click', function(){ H.exportTendersCSV(State.tenders); });
  function jump(path, btnId){
    go(path);
    setTimeout(function(){ var b = document.getElementById(btnId); if (b) b.click(); }, 150);
  }
  on('sysOrders','click', function(){ jump('/admin/orders', 'oExport'); });
  on('sysCustomers','click', function(){ jump('/admin/customers', 'cExport'); });
  on('sysPartners','click', function(){ jump('/admin/partners', 'pExport'); });
  on('sysQuotes','click', function(){ jump('/admin/quotes', 'qExport'); });
  on('sysRates','click', function(){ jump('/admin/rates', 'rExport'); });
  on('sysImport','click', function(){
    var f = document.getElementById('sysImportFile');
    if (!f || !f.files || !f.files[0]) { toast('error','No file chosen','Choose a JSON backup file first.'); return; }
    var r = new FileReader();
    r.onload = function(){
      try {
        var parsed = JSON.parse(String(r.result));
        var data = parsed.data || parsed;
        if (!data.services || !data.settings || !data.tenders) throw new Error('missing sections');
        confirmAction('Restore this backup?','All current records will be replaced with the contents of the backup file. This cannot be undone.', function(){
          State = data;
          if (!State.expenses) State.expenses = [];
          if (!State.activity) State.activity = [];
          save();
          logActivity('Restored data from a backup file');
          toast('ok','Backup restored','Records replaced from the backup file.');
          render();
        }, 'Restore backup');
      } catch(e) {
        toast('error','Could not read that file','It does not look like a backup JSON file produced by this system.');
      }
    };
    r.onerror = function(){ toast('error','Could not read that file','Try again, or use a different backup file.'); };
    r.readAsText(f.files[0]);
  });
  on('sysClearSamples','click', function(){
    confirmAction('Remove all sample data?','Every record marked “Sample” — tenders, services, rates, partners, orders, customers, quotations and expenses — will be deleted. Your own records are kept.', function(){
      var removed = 0;
      ['tenders','services','rates','partners','orders','customers','quotes','expenses'].forEach(function(k){
        var before = (State[k] || []).length;
        State[k] = (State[k] || []).filter(function(x){ return !x.sample; });
        removed += before - State[k].length;
      });
      State.sampleDataLoaded = false;
      logActivity('Removed ' + removed + ' sample record(s)');
      save();
      toast('ok','Sample data removed', removed + ' sample item(s) deleted. Your own records are untouched.');
      render();
    }, 'Remove sample data');
  });
  on('sysReloadSamples','click', function(){
    confirmAction('Reload sample data?','The original demonstration records are added back, clearly marked as sample. Your own records stay as they are.', function(){
      var fresh = seedState(), added = 0;
      ['tenders','services','rates','partners','orders','customers','quotes','expenses'].forEach(function(k){
        fresh[k].forEach(function(row){
          var dup = (State[k] || []).some(function(x){ return x.id === row.id; });
          if (!dup) { State[k].push(row); added++; }
        });
      });
      State.sampleDataLoaded = true;
      logActivity('Reloaded sample data (' + added + ' records)');
      save();
      toast('ok','Sample data reloaded', added + ' sample record(s) added back, marked as sample.');
      render();
    }, 'Reload samples');
  });
  on('sysWipe','click', function(){
    confirmAction('Delete everything and reset?','All records in this browser will be erased and the system returns to a fresh install with the default administrator account. This cannot be undone.', function(){
      State = seedState();
      State.tenders = []; State.orders = []; State.customers = []; State.quotes = []; State.partners = [];
      State.expenses = []; State.rates = []; State.services = []; State.activity = [];
      State.sampleDataLoaded = false;
      save();
      clearSession();
      toast('ok','System reset','All records cleared. A fresh administrator account is ready.');
      go('/admin'); render();
    }, 'Delete everything');
  });
};

