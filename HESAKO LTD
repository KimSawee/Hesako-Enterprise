  var t = editing || { title:'', description:'', buyer:'', refNo:'', category:'', publicationDate:'', siteVisitDate:'', questionDeadline:'',
    submissionDate:'', submissionTime:'11:00', openingDate:'', estimatedValue:'', quotedRate:'', quotedTotal:'', partner:'',
    requirements:'', documentsChecklist:[], submissionMethod:'', sourceLink:'', assignedTo: Session.name, notes:'', attachments:[],
    status:'Researching', outcome:'', contractValue:'', tasks:[], archived:false };
  var cats = ['Stationery','ICT & Electronics','Furniture','Cleaning & Hygiene','Print & Branding','Safety & Uniforms','General Supplies','Electrical & Plumbing','Maintenance','Tender Services','Logistics'];
  var partnerNames = State.partners.map(function(p){ return p.brand || p.name; });
  if (t.partner && partnerNames.indexOf(t.partner) === -1) partnerNames.push(t.partner);
  var staffNames = State.users.map(function(u){ return u.name; });
  if (t.assignedTo && staffNames.indexOf(t.assignedTo) === -1) staffNames.push(t.assignedTo);
  function opts(arr, sel, anyLabel){
    return (anyLabel ? '<option value="">' + esc(anyLabel) + '</option>' : '') + arr.map(function(o){
      return '<option' + (sel === o ? ' selected' : '') + '>' + esc(o) + '</option>';
    }).join('');
  }

  return H.adminHead(editing ? 'Edit tender record' : 'New tender record',
    '<a href="#/admin/tenders">Tender records</a> · ' + (editing ? 'editing “' + esc(t.title) + '”' : 'create a new record'),
    '<button class="btn btn-outline btn-sm" id="tfCancel">Cancel</button>' +
    '<button class="btn btn-gold btn-sm" id="tfSave">' + (editing ? 'Save changes' : 'Create record') + '</button>') +
  '<form id="tenderForm" novalidate>' +
  '<div class="panel"><div class="panel-head"><h3>Tender details</h3><span class="badge b-grey">All dates &amp; times in Africa/Nairobi (EAT)</span></div><div class="panel-body">' +
    '<div class="form-grid">' +
      '<div class="field span2"><label for="fTitle">Tender title *</label><input id="fTitle" value="' + esc(t.title) + '" placeholder="e.g. Supply of office stationery and consumables"><div class="err">Enter the tender title.</div></div>' +
      '<div class="field"><label for="fBuyer">Procuring entity / buyer</label><input id="fBuyer" value="' + esc(t.buyer) + '"><div class="err"></div></div>' +
      '<div class="field"><label for="fRef">Tender reference number</label><input id="fRef" class="mono" value="' + esc(t.refNo) + '" placeholder="e.g. ENT/014/2026-2027"><div class="err"></div></div>' +
      '<div class="field"><label for="fCat">Tender category</label><select id="fCat"><option value="">— Select —</option>' + opts(cats, t.category) + '</select><div class="err"></div></div>' +
      '<div class="field"><label for="fAssigned">Assigned staff member</label><select id="fAssigned"><option value="">— Unassigned —</option>' + opts(staffNames, t.assignedTo) + '</select><div class="err"></div></div>' +
      '<div class="field span2"><label for="fDesc">Tender description</label><textarea id="fDesc" placeholder="What is being procured, scope, quantities, duration.">' + esc(t.description) + '</textarea><div class="err"></div></div>' +
    '</div>' +
  '</div></div>' +

  '<div class="panel mt2"><div class="panel-head"><h3>Key dates &amp; deadlines</h3><span class="muted" style="font-size:.82rem">These drive the reminder centre</span></div><div class="panel-body">' +
    '<div class="form-grid-3">' +
      '<div class="field"><label for="fPub">Tender publication date</label><input id="fPub" type="date" value="' + esc(t.publicationDate) + '"><div class="err">Use a valid date.</div></div>' +
      '<div class="field"><label for="fSite">Site visit / pre-bid meeting</label><input id="fSite" type="date" value="' + esc(t.siteVisitDate) + '"><div class="err">Use a valid date.</div></div>' +
      '<div class="field"><label for="fQDead">Question &amp; clarification deadline</label><input id="fQDead" type="date" value="' + esc(t.questionDeadline) + '"><div class="err">Use a valid date.</div></div>' +
      '<div class="field"><label for="fSubDate">Submission deadline *</label><input id="fSubDate" type="date" value="' + esc(t.submissionDate) + '"><div class="err">Enter the submission deadline date.</div></div>' +
      '<div class="field"><label for="fSubTime">Submission time (EAT) *</label><input id="fSubTime" type="time" value="' + esc(t.submissionTime || '11:00') + '"><div class="err">Enter the submission time.</div></div>' +
      '<div class="field"><label for="fOpen">Tender opening date (if applicable)</label><input id="fOpen" type="date" value="' + esc(t.openingDate) + '"><div class="err">Use a valid date.</div></div>' +
    '</div>' +
    '<div class="notice notice-info" style="margin:0"><b>Time zone.</b> Deadlines are recorded and shown in <b>Africa/Nairobi (EAT, UTC+3)</b>, and written as “18 Oct 2026” so day and month are never confused.</div>' +
  '</div></div>' +

  '<div class="panel mt2"><div class="panel-head"><h3>Value, rates &amp; supplier</h3></div><div class="panel-body"><div class="form-grid-3">' +
      '<div class="field"><label for="fEst">Estimated tender value (KES)</label><input id="fEst" inputmode="numeric" value="' + esc(t.estimatedValue) + '"><div class="err">Digits only.</div></div>' +
      '<div class="field"><label for="fQRate">Quoted rate (unit, KES)</label><input id="fQRate" inputmode="numeric" value="' + esc(t.quotedRate) + '"><div class="err">Digits only.</div></div>' +
      '<div class="field"><label for="fQTotal">Total quoted amount (KES)</label><input id="fQTotal" inputmode="numeric" value="' + esc(t.quotedTotal) + '"><div class="err">Digits only.</div></div>' +
      '<div class="field"><label for="fPartner">Supplier / partner involved</label><select id="fPartner"><option value="">— None —</option>' + opts(partnerNames, t.partner) + '</select><div class="err"></div></div>' +
      '<div class="field"><label for="fStatus">Tender status</label><select id="fStatus">' + opts(TENDER_STATUSES, t.status) + '</select><div class="err"></div></div>' +
      '<div class="field"><label for="fOutcome">Final contract value (KES)</label><input id="fOutcome" inputmode="numeric" value="' + esc(t.contractValue) + '"><div class="err">Digits only.</div></div>' +
      '<div class="field span3"><label for="fOutcomeText">Outcome notes</label><input id="fOutcomeText" value="' + esc(t.outcome) + '" placeholder="e.g. Awarded — LPO received 14 Oct 2026"><div class="err"></div></div>' +
    '</div>' +
    '<p class="muted" style="font-size:.8rem;margin:0">Quoted figures are internal. Nothing here is a confirmed price until it is issued to a customer in a written quotation.</p>' +
  '</div></div>' +

  '<div class="panel mt2"><div class="panel-head"><h3>Requirements, documents &amp; submission</h3></div><div class="panel-body">' +
    '<div class="field"><label for="fReq">Tender requirements and eligibility criteria</label><textarea id="fReq" placeholder="Registration, tax compliance, experience, capacity, bid security…">' + esc(t.requirements) + '</textarea><div class="err"></div></div>' +
    '<div class="form-grid">' +
      '<div class="field"><label for="fMethod">Submission method</label><input id="fMethod" value="' + esc(t.submissionMethod) + '" placeholder="e.g. sealed bid to the tender box / e-procurement portal"><div class="err"></div></div>' +
      '<div class="field"><label for="fLink">Official source link</label><input id="fLink" value="' + esc(t.sourceLink) + '" placeholder="https://… official tender notice or portal"><div class="err">Enter a full link starting with http.</div></div>' +
    '</div>' +
    '<div class="field"><label>Required documents checklist</label>' + checklistHTML(t.documentsChecklist) + '<div class="hint">Tick items off as the bid is compiled.</div></div>' +
    '<div class="field"><label for="fAttach">Attach tender documents</label><input id="fAttach" type="file" multiple>' +
      '<div class="hint">Files up to 200KB each are stored inside the record in this browser; larger files are recorded by name and size only. Always keep the originals in your normal document storage.</div>' +
      ((t.attachments||[]).length ? '<div class="tag-list" style="margin-top:8px">' + t.attachments.map(function(a){
        return '<span class="pill">📎 ' + esc(a.name) + (a.data ? ' <a href="' + a.data + '" download="' + esc(a.name) + '">download</a>' : '') + '</span>';
      }).join('') + '</div>' : '') +
    '</div>' +
    '<div class="field"><label for="fNotes">Internal notes and follow-up actions</label><textarea id="fNotes" placeholder="Private notes — never shown publicly.">' + esc(t.notes) + '</textarea><div class="err"></div></div>' +
