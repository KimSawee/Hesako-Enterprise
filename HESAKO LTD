/* ------------------------------ deadline helpers ------------------------------ */
H.dueBuckets = function(){
  var t = todayISO();
  var open = State.tenders.filter(function(x){ return !x.archived && ['Submitted','Awarded','Unsuccessful','Cancelled','Expired'].indexOf(x.status) === -1; });
  var b = { overdue:[], today:[], d3:[], d7:[], later:[], none:[] };
  open.forEach(function(x){
    var d = daysLeft(x.submissionDate, x.submissionTime);
    if (d === null) { b.none.push(x); return; }
    if (d < 0) b.overdue.push(x);
    else if (d < 1) b.today.push(x);
    else if (d <= 3) b.d3.push(x);
    else if (d <= 7) b.d7.push(x);
    else b.later.push(x);
  });
  return b;
};
H.countDue = function(){
  var b = H.dueBuckets();
  return b.overdue.length + b.today.length + b.d3.length + b.d7.length;
};
function deadlineRow(t){
  var c = countdownLabel(t.submissionDate, t.submissionTime);
