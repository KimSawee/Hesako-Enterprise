  });
  function openPartner(rec){
    openModal({
      title: rec ? 'Edit partner' : 'New brand partner / supplier', wide: true,
      body: partnerModal(rec),
      foot: '<button class="btn btn-outline" data-close="1">Cancel</button><button class="btn btn-gold" id="ppSave">' + (rec ? 'Save partner' : 'Add partner') + '</button>'
    });
    on('ppSave','click', function(){
      var brand = val('ppBrand'); var ok = true;
      if (brand.length < 2) { setErr('ppBrand','Enter the brand name.'); ok = false; }
      if (val('ppEmail') && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('ppEmail'))) { setErr('ppEmail','Enter a valid email.'); ok = false; }
      if (val('ppWeb') && !/^https?:\/\//i.test(val('ppWeb'))) { setErr('ppWeb','Enter a full link starting with http:// or https://'); ok = false; }
