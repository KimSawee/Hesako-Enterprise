          (State.activity.length ? State.activity.slice(0,8).map(function(a){
            return '<div style="font-size:.85rem;padding:.4rem 0;border-bottom:1px solid var(--line)"><div>' + esc(a.text) + '</div>' +
              '<div class="muted" style="font-size:.76rem">' + esc(a.at) + ' · ' + esc(a.by) + '</div></div>';
          }).join('') : '<div class="empty">Activity will appear here as you work.</div>') +
        '</div></div>' +
        '<div class="panel mt2"><div class="panel-head"><h3>Quick actions</h3></div><div class="panel-body">' +
          '<div class="btn-row" style="flex-direction:column">' +
          '<a class="btn btn-navy btn-block" href="#/admin/tender-new">Add a tender record</a>' +
