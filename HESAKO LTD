  function reload(){ H.renderCustomerList(host); }
  on('cQ','input', debounce(function(){ custFilter.q = val('cQ'); reload(); }, 200));
  on('cClear','click', function(){ custFilter.q = ''; reload(); });
  on('cNew','click', function(){ customerModal(null, reload); });
  on('cExport','click', function(){
    var rows = [['Customer','Contact person','Phone','Email','Location','Status','Follow-up date','Orders','Quotations issued','Outstanding','Notes','Created','Sample']];
    (H.__custRows || State.customers).forEach(function(c){
      var orders = State.orders.filter(function(o){ return (o.email || '').toLowerCase() === (c.email || '').toLowerCase() || o.customer === c.name; });
      var quotes = State.quotes.filter(function(q){ return (q.email || '').toLowerCase() === (c.email || '').toLowerCase() || q.customer === c.name; });
      var out = orders.filter(function(o){ return ['New','Under Review','Quotation Sent','Awaiting Customer Approval'].indexOf(o.status) !== -1; }).length;
      rows.push([c.name, c.contactPerson, c.phone, c.email, c.location, c.status, c.followUp, orders.length, quotes.length, out, (c.notes || '').replace(/\n/g, ' '), c.createdAt, c.sample ? 'Yes' : 'No']);
    });
    if (downloadFile('hesako-customers-' + todayISO() + '.csv', toCSV(rows))) toast('ok','CSV exported','Customer list exported — contains personal data.');
  });
  host.addEventListener('click', function(e){
    var t = e.target;
    var v = t.closest && t.closest('[data-cview]');
    if (v) {
      var c = State.customers.filter(function(x){ return x.id === v.getAttribute('data-cview'); })[0];
      if (!c) return;
      var orders = State.orders.filter(function(o){ return (o.email || '').toLowerCase() === (c.email || '').toLowerCase() || o.customer === c.name; });
      var quotes = State.quotes.filter(function(q){ return (q.email || '').toLowerCase() === (c.email || '').toLowerCase() || q.customer === c.name; });
      openModal({
        title: 'Customer history — ' + c.name, wide: true,
        body: '<div class="grid g3" style="margin-bottom:14px">' +
            kpi('', 'Orders', orders.length, 'All time') + kpi('', 'Quotations issued', quotes.length, 'All time') +
            kpi('', 'Outstanding', orders.filter(function(o){ return ['New','Under Review','Quotation Sent','Awaiting Customer Approval'].indexOf(o.status) !== -1; }).length, 'Awaiting a decision') +
          '</div>' +
          '<table style="min-width:0"><tbody>' +
            '<tr><th class="no-sort" style="width:30%">Contact</th><td>' + esc(c.contactPerson || '—') + ' · ' + esc(c.phone || '') + ' · ' + esc(c.email || '') + '</td></tr>' +
            '<tr><th class="no-sort">Delivery location</th><td>' + esc(c.location || '—') + '</td></tr>' +
            '<tr><th class="no-sort">Status / follow-up</th><td>' + statusBadge(c.status) + ' · next follow-up ' + esc(fmtDate(c.followUp)) + '</td></tr>' +
            '<tr><th class="no-sort">Communication notes</th><td>' + esc(c.notes || '—') + '</td></tr>' +
          '</tbody></table>' +
          '<h4 style="margin-top:16px">Order history</h4>' +
          (orders.length ? '<div class="table-wrap"><table><thead><tr><th class="no-sort">Reference</th><th class="no-sort">Date</th><th class="no-sort">Service</th><th class="no-sort">Status</th></tr></thead><tbody>' +
            orders.map(function(o){ return '<tr><td class="mono">' + esc(o.ref) + '</td><td>' + esc(fmtDate(o.createdAt)) + '</td><td>' + esc(o.service) + '</td><td>' + statusBadge(o.status) + '</td></tr>'; }).join('') +
            '</tbody></table></div>' : '<p class="muted" style="font-size:.88rem">No orders recorded.</p>') +
          '<h4 style="margin-top:16px">Quotations issued</h4>' +
          (quotes.length ? '<div class="table-wrap"><table><thead><tr><th class="no-sort">Reference</th><th class="no-sort">Date</th><th class="no-sort">Total</th><th class="no-sort">Status</th></tr></thead><tbody>' +
            quotes.map(function(q){ var t2 = H.quoteTotals(q); return '<tr><td class="mono">' + esc(q.ref) + '</td><td>' + esc(fmtDate(q.date)) + '</td><td>' + money(t2.total) + '</td><td>' + statusBadge(q.status) + '</td></tr>'; }).join('') +
            '</tbody></table></div>' : '<p class="muted" style="font-size:.88rem">No quotations issued.</p>'),
        foot: '<button class="btn btn-outline" data-close="1">Close</button>' +
          (c.email ? '<a class="btn btn-outline" href="mailto:' + esc(c.email) + '">Email customer</a>' : '') +
          '<button class="btn btn-gold" id="cvProfile">Edit profile</button>'
      });
      on('cvProfile','click', function(){ closeModal(); customerModal(c, reload); });
      return;
    }
    var ed = t.closest && t.closest('[data-cedit]');
    if (ed) { customerModal(State.customers.filter(function(x){ return x.id === ed.getAttribute('data-cedit'); })[0], reload); return; }
    var dl = t.closest && t.closest('[data-cdel]');
    if (dl) {
      var id = dl.getAttribute('data-cdel');
      var rec = State.customers.filter(function(x){ return x.id === id; })[0];
      confirmAction('Delete customer record?','“' + (rec ? rec.name : '') + '” will be removed. Their orders stay on record.', function(){
        State.customers = State.customers.filter(function(x){ return x.id !== id; });
        logActivity('Deleted customer: ' + (rec ? rec.name : id)); save(); toast('ok','Customer deleted',''); reload();
      }, 'Delete customer');
    }
  });
};
function customerModal(rec, onSaved){
  var c = rec || { name:'', contactPerson:'', phone:'', email:'', location:'', status:'Prospect', followUp:addDays(todayISO(), 2), notes:'' };
  openModal({
    title: rec ? 'Edit customer' : 'New customer', wide: true,
    body: '<div class="form-grid">' +
      '<div class="field"><label for="ccName">Customer / business name *</label><input id="ccName" value="' + esc(c.name) + '"><div class="err">Enter the customer name.</div></div>' +
      '<div class="field"><label for="ccContact">Contact person</label><input id="ccContact" value="' + esc(c.contactPerson) + '"><div class="err"></div></div>' +
      '<div class="field"><label for="ccPhone">Phone</label><input id="ccPhone" value="' + esc(c.phone) + '"><div class="err"></div></div>' +
      '<div class="field"><label for="ccEmail">Email</label><input id="ccEmail" type="email" value="' + esc(c.email) + '"><div class="err">Enter a valid email.</div></div>' +
      '<div class="field"><label for="ccLoc">Delivery location</label><input id="ccLoc" value="' + esc(c.location) + '"><div class="err"></div></div>' +
      '<div class="field"><label for="ccStatus">Customer status</label><select id="ccStatus">' +
        ['Prospect','Active','Follow-up due','Dormant','Closed'].map(function(s){ return '<option' + (c.status === s ? ' selected' : '') + '>' + esc(s) + '</option>'; }).join('') + '</select><div class="err"></div></div>' +
      '<div class="field span2"><label for="ccFollow">Next follow-up date</label><input id="ccFollow" type="date" value="' + esc(c.followUp) + '"><div class="err"></div></div>' +
      '<div class="field span2"><label for="ccNotes">Communication notes</label><textarea id="ccNotes" style="min-height:90px">' + esc(c.notes) + '</textarea><div class="err"></div></div>' +
    '</div>',
    foot: '<button class="btn btn-outline" data-close="1">Cancel</button><button class="btn btn-gold" id="ccSave">' + (rec ? 'Save customer' : 'Add customer') + '</button>'
  });
  on('ccSave','click', function(){
    var name = val('ccName'); var ok = true;
    if (name.length < 2) { setErr('ccName','Enter the customer name.'); ok = false; }
    if (val('ccEmail') && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('ccEmail'))) { setErr('ccEmail','Enter a valid email.'); ok = false; }
    if (!ok) { toast('error','Check the fields','Some values need correcting.'); return; }
    var row = rec || { id: uid('cu'), createdAt: todayISO(), sample:false };
    row.name = name; row.contactPerson = val('ccContact'); row.phone = val('ccPhone'); row.email = val('ccEmail');
    row.location = val('ccLoc'); row.status = val('ccStatus'); row.followUp = val('ccFollow'); row.notes = val('ccNotes');
    if (!rec) State.customers.unshift(row);
    logActivity((rec ? 'Updated' : 'Added') + ' customer: ' + row.name);
    if (!save()) { toast('error','Not saved','Local storage is blocked in this browser.'); return; }
    closeModal(); toast('ok', rec ? 'Customer updated' : 'Customer added', row.name); onSaved();
  });
}
})();
</script>

<script>
/* ==========================================================================
   ADMIN 5 — reports, settings, staff accounts, data &amp; backups
   ========================================================================== */
(function () {
'use strict';
var H = window.HESAKO = window.HESAKO || {};

/* ------------------------------ reports ------------------------------ */
function barChart(rows, valueKey){
  var max = Math.max.apply(null, rows.map(function(r){ return num(r[valueKey]); }).concat([1]));
  return '<div>' + rows.map(function(r){
    var w = Math.round((num(r[valueKey]) / max) * 100);
    return '<div style="margin-bottom:9px"><div style="display:flex;justify-content:space-between;font-size:.82rem"><span>' + esc(r.label) + '</span><strong>' + esc(r.display || r[valueKey]) + '</strong></div>' +
      '<div style="height:9px;background:#eef2f8;border-radius:6px;overflow:hidden"><div style="height:100%;width:' + w + '%;background:linear-gradient(90deg,var(--navy),var(--gold))"></div></div></div>';
  }).join('') + '</div>';
}
H.adminReports = function(){
  var from = H.__repFrom || addDays(todayISO(), -180), to = H.__repTo || todayISO();
  var tenders = State.tenders.filter(function(t){ return (!from || t.createdAt >= from) && (!to || t.createdAt <= to); });
  var orders = State.orders.filter(function(o){ return (!from || o.createdAt >= from) && (!to || o.createdAt <= to); });
  var b = H.dueBuckets();
  var quoted = tenders.reduce(function(a, t){ return a + num(t.quotedTotal); }, 0);
  var confirmedValue = orders.filter(function(o){ return ['Confirmed','In Progress','Completed'].indexOf(o.status) !== -1; })
    .reduce(function(a, o){ return a + num(o.budget); }, 0);
  var quotedOrders = State.quotes.reduce(function(a, q){ return a + quoteTotals(q).total; }, 0);
  var expenses = State.expenses.reduce(function(a, e){ return a + num(e.amount); }, 0);
  var MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var months = [];
  for (var i = 5; i >= 0; i--) {
    var d = new Date(); d.setDate(1); d.setMonth(d.getMonth() - i);
    months.push({ key: d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2), label: MN[d.getMonth()] + ' ' + String(d.getFullYear()).slice(2) });
  }
  var mTenders = months.map(function(m){ return { label:m.label, count: State.tenders.filter(function(t){ return (t.createdAt || '').slice(0,7) === m.key; }).length }; });
  var mOrders = months.map(function(m){ return { label:m.label, count: State.orders.filter(function(o){ return (o.createdAt || '').slice(0,7) === m.key; }).length }; });
  var mValue = months.map(function(m){
    var v = State.orders.filter(function(o){ return (o.createdAt || '').slice(0,7) === m.key && ['Confirmed','In Progress','Completed'].indexOf(o.status) !== -1; })
      .reduce(function(a, o){ return a + num(o.budget); }, 0);
    return { label:m.label, value:v, display: money0(v) };
  });
  mTenders.forEach(function(x){ x.display = String(x.count); });
  mOrders.forEach(function(x){ x.display = String(x.count); });

  return H.adminHead('Reports &amp; business analytics', 'Calculated live from the records in this system · period ' + esc(fmtDate(from)) + ' to ' + esc(fmtDate(to)),
    '<button class="btn btn-outline btn-sm" id="repExpense">+ Record expense</button>' +
    '<button class="btn btn-outline btn-sm" id="repExport">Export report CSV</button>') +
  '<div class="toolbar">' +
    '<div class="field"><label for="repFrom">From date</label><input id="repFrom" type="date" value="' + esc(from) + '"></div>' +
    '<div class="field"><label for="repTo">To date</label><input id="repTo" type="date" value="' + esc(to) + '"></div>' +
    '<div class="field"><label>&nbsp;</label><button class="btn btn-navy" id="repApply">Apply filter</button></div>' +
    '<div class="field"><label>&nbsp;</label><button class="btn btn-outline" id="repReset">Reset to last 6 months</button></div>' +
  '</div>' +
  '<div class="grid g4" style="margin-bottom:18px">' +
    kpi('k-navy', 'Tenders recorded', tenders.length, 'Created in the period') +
    kpi('k-warn', 'Awaiting submission', b.overdue.length + b.today.length + b.d3.length + b.d7.length, 'Open records with a deadline') +
    kpi('k-ok', 'Tenders submitted', tenders.filter(function(t){ return ['Submitted','Under Evaluation'].indexOf(t.status) !== -1; }).length, 'In the period') +
    kpi('', 'Tenders awarded', tenders.filter(function(t){ return t.status === 'Awarded'; }).length, 'In the period') +
    kpi('', 'Tenders unsuccessful', tenders.filter(function(t){ return t.status === 'Unsuccessful'; }).length, 'In the period') +
    kpi(b.overdue.length ? 'k-bad' : 'k-ok', 'Overdue now', b.overdue.length, 'Live, regardless of filter') +
    kpi('k-navy', 'Total quoted value', money0(quoted), 'Sum of quoted totals in the period') +
    kpi('k-navy', 'Quoted to customers', money0(quotedOrders), 'All quotations, all time') +
    kpi('k-ok', 'Confirmed order value', money0(confirmedValue), 'Confirmed, in progress, completed') +
    kpi('', 'Orders awaiting review', State.orders.filter(function(o){ return ['New','Under Review'].indexOf(o.status) !== -1; }).length, 'Live') +
    kpi('k-ok', 'Active brand partnerships', State.partners.filter(function(p){ return p.status === 'Active'; }).length, 'Status = Active') +
    kpi('', 'Expenses recorded', money0(expenses), State.expenses.length + ' entries') +
  '</div>' +
  '<div class="notice notice-warn"><b>Estimates vs actuals.</b> “Quoted value” and the budgets customers state are <b>estimates</b>. Only confirmed order value and recorded contract values are <b>actual</b> business. Never present an estimate as revenue.</div>' +
  '<div class="grid g3" style="margin-bottom:18px">' +
    '<div class="panel"><div class="panel-head"><h3>Tenders recorded per month</h3></div><div class="panel-body">' + barChart(mTenders, 'count') + '</div></div>' +
    '<div class="panel"><div class="panel-head"><h3>Orders received per month</h3></div><div class="panel-body">' + barChart(mOrders, 'count') + '</div></div>' +
    '<div class="panel"><div class="panel-head"><h3>Confirmed order value per month</h3></div><div class="panel-body">' + barChart(mValue, 'value') +
      '<p class="muted" style="font-size:.76rem;margin:.6rem 0 0">Actual confirmed business only, using the customer’s stated budget where no invoiced figure is recorded.</p></div></div>' +
  '</div>' +
  '<div class="grid g2">' +
    '<div class="panel"><div class="panel-head"><h3>Tender pipeline by status</h3></div><div class="panel-body">' +
      TENDER_STATUSES.map(function(s){
        var n = State.tenders.filter(function(t){ return t.status === s && !t.archived; }).length;
        return '<div class="set-row"><span class="s-label">' + esc(s) + '</span><span><strong>' + n + '</strong> ' + statusBadge(s) + '</span></div>';
      }).join('') + '</div></div>' +
    '<div class="panel"><div class="panel-head"><h3>Orders by status</h3></div><div class="panel-body">' +
      ORDER_STATUSES.map(function(s){
        var list = State.orders.filter(function(o){ return o.status === s; });
        var v = list.reduce(function(a, o){ return a + num(o.budget); }, 0);
        return '<div class="set-row"><span class="s-label">' + esc(s) + '</span><span><strong>' + list.length + '</strong> · ' + money0(v) + ' ' + statusBadge(s) + '</span></div>';
      }).join('') + '</div></div>' +
  '</div>' +
  '<div class="panel mt2"><div class="panel-head"><h3>Expenses recorded</h3><span class="muted" style="font-size:.82rem">Feeds the simple revenue vs cost view</span></div>' +
    '<div class="table-wrap"><table><thead><tr><th class="no-sort">Date</th><th class="no-sort">Description</th><th class="no-sort">Category</th><th class="no-sort">Amount</th><th class="no-sort"></th></tr></thead><tbody>' +
    (State.expenses.length ? State.expenses.map(function(e){
      return '<tr><td>' + esc(fmtDate(e.date)) + '</td><td>' + esc(e.description) + sampleTag(e) + '</td><td>' + esc(e.category) + '</td><td>' + money(e.amount) + '</td>' +
        '<td class="actions"><button class="btn btn-xs btn-danger" data-exdel="' + esc(e.id) + '">Delete</button></td></tr>';
    }).join('') : '<tr><td colspan="5"><div class="empty">No expenses recorded.</div></td></tr>') +
  '</tbody></table></div>' +
  '<div class="panel-foot"><span>Total expenses: <strong>' + money(expenses) + '</strong></span>' +
    '<span>Confirmed order value less expenses: <strong>' + money(confirmedValue - expenses) + '</strong> (indicative view only)</span></div></div>';
};
H.afterRenderReports = function(){
  var from = H.__repFrom || addDays(todayISO(), -180), to = H.__repTo || todayISO();
  on('repApply','click', function(){ H.__repFrom = val('repFrom'); H.__repTo = val('repTo'); render(); });
  on('repReset','click', function(){ H.__repFrom = addDays(todayISO(), -180); H.__repTo = todayISO(); render(); });
  on('repExpense','click', function(){
    openModal({
      title: 'Record an expense',
      body: '<div class="form-grid">' +
        '<div class="field"><label for="exDate">Date *</label><input id="exDate" type="date" value="' + todayISO() + '"><div class="err">Choose a date.</div></div>' +
        '<div class="field"><label for="exCat">Category</label><input id="exCat" value="Transport"><div class="err"></div></div>' +
        '<div class="field span2"><label for="exDesc">Description *</label><input id="exDesc" placeholder="e.g. transport to deliver stationery to the customer"><div class="err">Describe the expense.</div></div>' +
        '<div class="field"><label for="exAmt">Amount (KES) *</label><input id="exAmt" inputmode="numeric"><div class="err">Enter the amount in digits.</div></div>' +
      '</div>',
      foot: '<button class="btn btn-outline" data-close="1">Cancel</button><button class="btn btn-gold" id="exSave">Save expense</button>'
    });
    on('exSave','click', function(){
      var ok = true, d = val('exDate'), desc = val('exDesc'), amt = val('exAmt');
      if (!d) { setErr('exDate','Choose a date.'); ok = false; }
      if (desc.length < 3) { setErr('exDesc','Describe the expense.'); ok = false; }
      if (!/^\d+(\.\d+)?$/.test(amt.replace(/,/g, ''))) { setErr('exAmt','Enter the amount in digits.'); ok = false; }
      if (!ok) { toast('error','Check the fields','Some values need correcting.'); return; }
      State.expenses.unshift({ id: uid('ex'), date:d, description:desc, category:val('exCat'), amount: num(amt), sample:false });
      logActivity('Recorded expense: ' + desc + ' ' + money0(num(amt)));
      save(); closeModal(); toast('ok','Expense recorded', desc + ' — ' + money(num(amt))); render();
    });
  });
  on('repExport','click', function(){
    var rows = [['HESAKO ENTERPRISE LTD — business report', 'Period ' + from + ' to ' + to], [], ['TENDERS'],
      ['Title','Buyer','Submission','Status','Estimated value','Quoted total','Contract value']];
    State.tenders.forEach(function(t){ rows.push([t.title, t.buyer, t.submissionDate, t.status, t.estimatedValue, t.quotedTotal, t.contractValue]); });
    rows.push([], ['ORDERS'], ['Reference','Customer','Type','Service','Budget estimate','Status','Received']);
    State.orders.forEach(function(o){ rows.push([o.ref, o.customer, o.type, o.service, o.budget, o.status, o.createdAt]); });
    rows.push([], ['QUOTATIONS'], ['Reference','Customer','Subtotal','Delivery','VAT','Total','Status']);
    State.quotes.forEach(function(q){ var t = quoteTotals(q); rows.push([q.ref, q.customer, t.subtotal, t.delivery, t.vat, t.total, q.status]); });
    rows.push([], ['PARTNERS'], ['Brand','Industry','Status','Public']);
    State.partners.forEach(function(p){ rows.push([p.brand || p.name, p.industry, p.status, p.publicApproved ? 'Yes' : 'No']); });
    rows.push([], ['EXPENSES'], ['Date','Description','Category','Amount']);
    State.expenses.forEach(function(e){ rows.push([e.date, e.description, e.category, e.amount]); });
    if (downloadFile('hesako-report-' + todayISO() + '.csv', toCSV(rows))) toast('ok','Report exported','Combined business report downloaded as CSV.');
  });
  var main = (H.viewClickHost && H.viewClickHost()) || document.getElementById('main');
  main.addEventListener('click', function(e){
    var dl = e.target.closest && e.target.closest('[data-exdel]');
    if (dl) {
      var id = dl.getAttribute('data-exdel');
      State.expenses = State.expenses.filter(function(x){ return x.id !== id; });
      save(); toast('ok','Expense deleted',''); render();
    }
  });
};

/* ------------------------------ settings ------------------------------ */
function toIntl(p){
  var d = String(p || '').replace(/[^0-9]/g, '');
  if (d.indexOf('254') === 0) return '+' + d;
  if (d.indexOf('0') === 0) return '+254' + d.slice(1);
  return d ? '+' + d : '';
}
H.adminSettings = function(){
  var c = State.company, s = State.settings;
  return H.adminHead('Settings', 'Company details, quotation defaults, reminders and security', '') +
  '<div class="grid g2">' +
    '<div class="panel"><div class="panel-head"><h3>Company details</h3><span class="muted" style="font-size:.82rem">Used across the public site and on quotations</span></div><div class="panel-body">' +
      '<div class="field"><label for="stName">Company name</label><input id="stName" value="' + esc(c.name) + '"><div class="err">Enter the company name.</div></div>' +
      '<div class="field"><label for="stTag">Tagline / services line</label><input id="stTag" value="' + esc(c.tagline) + '"><div class="err"></div></div>' +
      '<div class="field"><label for="stMotto">Welcome motto</label><input id="stMotto" value="' + esc(c.motto) + '"><div class="err"></div></div>' +
